<?xml version="1.0"?>
<configuration>

	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Data Source=.;Initial Catalog=WebTuyenDungDB;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
	</system.web>

</configuration>
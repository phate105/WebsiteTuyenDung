@model WebsiteTuyenDung.Models.Entities.LoaiHinhLamViec

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Sửa loại hình làm việc";
    ViewBag.PageTitle = "Sửa loại hình làm việc";
}

<div class="box box-warning">
    <div class="box-header with-border">
        <h3 class="box-title">Cập nhật loại hình làm việc</h3>
    </div>

    @using (Html.BeginForm("Edit", "LoaiHinhLamViec", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.LoaiHinhLamViecId)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="box-body">
            <div class="form-group">
                <label>Tên loại hình làm việc</label>
                @Html.TextBoxFor(m => m.TenLoaiHinhLamViec, new { @class = "form-control", placeholder = "Nhập tên loại hình làm việc" })
                @Html.ValidationMessageFor(m => m.TenLoaiHinhLamViec, "", new { @class = "text-danger" })
            </div>
            <div class="checkbox">
                <label>@Html.CheckBoxFor(m => m.TrangThai) Đang sử dụng</label>
            </div>
        </div>
        <div class="box-footer">
            <button type="submit" class="btn btn-warning">Cập nhật</button>
            <a href="@Url.Action("Index", "LoaiHinhLamViec")" class="btn btn-default">Quay lại</a>
        </div>
    }
</div>

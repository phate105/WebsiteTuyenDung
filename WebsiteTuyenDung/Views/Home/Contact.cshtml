@{
    ViewBag.Title = "Liên hệ";
    ViewBag.PublicBodyClass = "info-page-area";
}

<section class="info-page">
    <div class="container">
        <div class="info-card">
            <div class="info-hero">
                <span class="clean-label">Hỗ trợ</span>
                <h1>Liên hệ VietJob</h1>
                <p>Nếu bạn cần hỗ trợ về tài khoản, hồ sơ ứng tuyển hoặc đăng tin tuyển dụng, hãy liên hệ với đội ngũ VietJob.</p>
            </div>

            <div class="info-content">
                <div class="info-grid">
                    <div class="info-box">
                        <i class="bi bi-geo-alt"></i>
                        <h3>Văn phòng</h3>
                        <p>TP. Hồ Chí Minh, Việt Nam</p>
                    </div>
                    <div class="info-box">
                        <i class="bi bi-envelope"></i>
                        <h3>Email</h3>
                        <p><a href="mailto:support@vietjob.local">support@vietjob.local</a></p>
                    </div>
                    <div class="info-box">
                        <i class="bi bi-telephone"></i>
                        <h3>Điện thoại</h3>
                        <p>0900 000 000</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

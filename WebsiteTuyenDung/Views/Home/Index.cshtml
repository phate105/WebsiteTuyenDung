@section scripts {
    <script>
        (function () {
            document.querySelectorAll(".hero-filter-menu .dropdown-item").forEach(function (item) {
                item.addEventListener("click", function () {
                    var targetId = item.getAttribute("data-target");
                    var target = document.getElementById(targetId);
                    var dropdown = item.closest(".hero-search-dropdown");
                    var label = item.getAttribute("data-label") || item.textContent.trim();

                    if (target) {
                        target.value = item.getAttribute("data-value") || "";
                    }

                    if (dropdown) {
                        var buttonLabel = dropdown.querySelector(".hero-filter-toggle span");
                        var toggle = dropdown.querySelector(".hero-filter-toggle");
                        var value = item.getAttribute("data-value") || "";
                        if (buttonLabel) {
                            buttonLabel.textContent = label;
                        }

                        if (toggle) {
                            toggle.classList.toggle("has-value", value.length > 0);
                        }

                        dropdown.querySelectorAll(".dropdown-item").forEach(function (option) {
                            option.classList.remove("active");
                        });
                    }

                    item.classList.add("active");
                });
            });

            var jobCards = Array.prototype.slice.call(document.querySelectorAll("[data-job-page]"));
            var pager = document.querySelector("[data-job-pager]");
            var prevButton = document.querySelector("[data-job-prev]");
            var nextButton = document.querySelector("[data-job-next]");
            var pageButtons = Array.prototype.slice.call(document.querySelectorAll("[data-job-page-button]"));
            var activePage = 1;

            function showJobPage(page) {
                activePage = page;

                jobCards.forEach(function (card) {
                    card.classList.toggle("is-hidden", parseInt(card.getAttribute("data-job-page"), 10) !== activePage);
                });

                pageButtons.forEach(function (button) {
                    button.classList.toggle("is-active", parseInt(button.getAttribute("data-job-page-button"), 10) === activePage);
                });

                if (prevButton) {
                    prevButton.disabled = activePage === 1;
                }

                if (nextButton) {
                    nextButton.disabled = activePage === pageButtons.length;
                }
            }

            if (pager && pageButtons.length > 0) {
                pageButtons.forEach(function (button) {
                    button.addEventListener("click", function () {
                        showJobPage(parseInt(button.getAttribute("data-job-page-button"), 10));
                    });
                });

                if (prevButton) {
                    prevButton.addEventListener("click", function () {
                        if (activePage > 1) {
                            showJobPage(activePage - 1);
                        }
                    });
                }

                if (nextButton) {
                    nextButton.addEventListener("click", function () {
                        if (activePage < pageButtons.length) {
                            showJobPage(activePage + 1);
                        }
                    });
                }

                showJobPage(1);
            }

            var employerCarousel = document.querySelector("[data-employer-carousel]");
            if (employerCarousel) {
                var employerViewport = employerCarousel.querySelector("[data-employer-viewport]");
                var employerTrack = employerCarousel.querySelector("[data-employer-track]");
                var employerCards = Array.prototype.slice.call(employerCarousel.querySelectorAll("[data-employer-card]"));
                var employerPrev = employerCarousel.querySelector("[data-employer-prev]");
                var employerNext = employerCarousel.querySelector("[data-employer-next]");
                var employerPage = 0;

                function getEmployerPerPage() {
                    if (window.innerWidth < 768) {
                        return 1;
                    }

                    if (window.innerWidth < 1200) {
                        return 2;
                    }

                    return 4;
                }

                function updateEmployerCarousel() {
                    if (!employerViewport || !employerTrack || employerCards.length === 0) {
                        return;
                    }

                    var perPage = getEmployerPerPage();
                    var maxPage = Math.max(0, Math.ceil(employerCards.length / perPage) - 1);
                    employerPage = Math.min(employerPage, maxPage);

                    var trackStyle = window.getComputedStyle(employerTrack);
                    var gap = parseFloat(trackStyle.columnGap || trackStyle.gap || "0") || 0;
                    var offset = employerPage * (employerViewport.clientWidth + gap);
                    employerTrack.style.transform = "translateX(-" + offset + "px)";

                    if (employerPrev) {
                        employerPrev.disabled = employerPage <= 0;
                    }

                    if (employerNext) {
                        employerNext.disabled = employerPage >= maxPage;
                    }
                }

                if (employerPrev) {
                    employerPrev.addEventListener("click", function () {
                        employerPage = Math.max(0, employerPage - 1);
                        updateEmployerCarousel();
                    });
                }

                if (employerNext) {
                    employerNext.addEventListener("click", function () {
                        employerPage += 1;
                        updateEmployerCarousel();
                    });
                }

                window.addEventListener("resize", updateEmployerCarousel);
                updateEmployerCarousel();
            }

        })();
    </script>
}

<section class="section-block section-soft" id="viec-lam-tot-nhat">
    <div class="container">
        <div class="section-heading-row">
            <div>
                <span class="section-label">Gợi ý cho bạn</span>
                <h2 class="section-heading">Việc làm tốt nhất</h2>
                <p class="section-summary">Những tin đã duyệt, còn hạn và có thông tin rõ ràng.</p>
            </div>
            <a href="@Url.Action("Index", "Job")" class="section-link">Xem tất cả việc làm</a>
        </div>

        @if (featuredJobs.Any())
        {
            <div class="job-grid">
                @for (var i = 0; i < featuredJobs.Count; i++)
                {
                    var job = featuredJobs[i];
                    var page = (i / jobsPerPage) + 1;
                    var jobLogoKey = (job.LogoCongTy ?? string.Empty).ToLowerInvariant();
                    var jobLogoClass = jobLogoKey.Contains("techcombank2") || jobLogoKey.Contains("yamaha2") || jobLogoKey.Contains("honda2") ? "is-new-logo" : string.Empty;
                    <article class="featured-job-card @(page > 1 ? "is-hidden" : string.Empty)" data-job-page="@page">
                        <div class="job-card-top">
                            <div class="job-card-logo @jobLogoClass">
                                @if (!string.IsNullOrWhiteSpace(job.LogoCongTy))
                                {
                                    <img src="@Url.Content(job.LogoCongTy)" alt="@job.TenCongTy" />
                                }
                                else
                                {
                                    <span class="job-card-logo-fallback">@job.TenCongTy.Substring(0, 1).ToUpper()</span>
                                }
                            </div>
                            <div class="job-card-main">
                                <h3>
                                    <a href="@Url.Action("Details", "Job", new { id = job.TinTuyenDungId })">@job.TieuDe</a>
                                </h3>
                                @if (job.HoSoCongTyId.HasValue)
                                {
                                    <a class="job-card-company" href="@Url.Action("Company", "Job", new { id = job.HoSoCongTyId.Value })">@job.TenCongTy</a>
                                }
                                else
                                {
                                    <span class="job-card-company">@job.TenCongTy</span>
                                }
                            </div>
                        </div>

                        <div class="job-card-bottom">
                            <div class="job-meta-list">
                                <span class="job-meta-pill">@CompactSalary(job.LuongHienThi)</span>
                                <span class="job-meta-pill">@job.TenDiaDiem</span>
                            </div>
                            <a href="@Url.Action("Details", "Job", new { id = job.TinTuyenDungId })" class="job-card-button">Chi tiết</a>
                        </div>
                    </article>
                }
            </div>

            if (totalJobPages > 1)
            {
                <div class="job-pager" data-job-pager>
                    <button type="button" class="job-pager-button" data-job-prev aria-label="Trang trước">‹</button>
                    @for (var page = 1; page <= totalJobPages; page++)
                    {
                        <button type="button" class="job-pager-dot @(page == 1 ? "is-active" : string.Empty)" data-job-page-button="@page" aria-label="Trang @page"></button>
                    }
                    <button type="button" class="job-pager-button" data-job-next aria-label="Trang sau">›</button>
                </div>
            }
        }
        else
        {
            <div class="empty-state p-5 text-center">
                <h5 class="mb-3">Chưa có việc làm công khai</h5>
                <p class="text-muted mb-0">Khi có tin tuyển dụng đã duyệt, khu vực này sẽ hiển thị ngay các cơ hội nổi bật.</p>
            </div>
        }
    </div>
</section>

<section class="section-block section-white" id="nha-tuyen-dung-tieu-bieu">
    <div class="container">
        <div class="section-heading-row">
            <div>
                <span class="section-label">Nhà tuyển dụng tiêu biểu</span>
                <h2 class="section-heading">Doanh nghiệp đang tuyển</h2>
                <p class="section-summary">Xem nhanh các công ty có nhiều vị trí mở.</p>
            </div>
            <a href="@Url.Action("Register", "Account")" class="section-link">Dành cho nhà tuyển dụng</a>
        </div>

        @if (employerCards.Any())
        {
            <div class="employer-carousel" data-employer-carousel>
                <button type="button" class="employer-carousel-button is-prev" data-employer-prev aria-label="Doanh nghiệp trước">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div class="employer-carousel-viewport" data-employer-viewport>
                    <div class="employer-grid" data-employer-track>
                @foreach (var employer in employerCards)
                {
                    var employerLogoKey = (employer.LogoCongTy ?? string.Empty).ToLowerInvariant();
                    var employerLogoClass = employerLogoKey.Contains("techcombank2") || employerLogoKey.Contains("yamaha2") || employerLogoKey.Contains("honda2") ? "is-new-logo" : string.Empty;
                    <a href="@Url.Action("Company", "Job", new { id = employer.HoSoCongTyId })" class="employer-card" data-employer-card>
                        <div class="employer-logo @employerLogoClass">
                            @if (!string.IsNullOrWhiteSpace(employer.LogoCongTy))
                            {
                                <img src="@Url.Content(employer.LogoCongTy)" alt="@employer.TenCongTy" />
                            }
                            else
                            {
                                <span class="employer-logo-fallback">@employer.TenCongTy.Substring(0, 1).ToUpper()</span>
                            }
                        </div>
                        <h3>@employer.TenCongTy</h3>
                        <span class="employer-count-pill">@employer.SoLuongTinDangTuyen việc đang tuyển</span>
                    </a>
                }
                    </div>
                </div>
                <button type="button" class="employer-carousel-button is-next" data-employer-next aria-label="Doanh nghiệp sau">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>

            if (employerRuntimeLogos.Any())
            {
                var employerLogoTrack = employerRuntimeLogos.Concat(employerRuntimeLogos).ToList();
                var employerLogoSizes = new[] { "is-medium", "is-small", "is-large", "is-medium", "is-small", "is-medium" };
                <div class="employer-logo-strip">
                    <div class="employer-logo-track">
                        @for (var i = 0; i < employerLogoTrack.Count; i++)
                        {
                            var logo = employerLogoTrack[i];
                            var sizeClass = employerLogoSizes[i % employerLogoSizes.Length];
                            var logoKey = logo.Item1.ToLowerInvariant();
                            var brandClass = logoKey.Contains("mobifone") ? "is-mobifone" : string.Empty;
                            var newLogoClass = logoKey.Contains("techcombank2") ? "is-new-logo" : string.Empty;
                            <div class="employer-logo-chip @sizeClass @brandClass @newLogoClass">
                                <img src="@logo.Item2" alt="@logo.Item1" loading="lazy" />
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state p-5 text-center">
                <h5 class="mb-3">Chưa có nhà tuyển dụng tiêu biểu</h5>
                <p class="text-muted mb-0">Khi có doanh nghiệp sở hữu tin đã duyệt, khu vực này sẽ hiển thị để tăng độ tin cậy cho trang chủ.</p>
            </div>
        }
    </div>
</section>


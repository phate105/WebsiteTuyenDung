@using System.Collections.Generic
@using System.IO
@using System.Linq
@using WebsiteTuyenDung.Models.ViewModels
@model HomeIndexViewModel
@{
    ViewBag.Title = "Trang chủ";
    ViewBag.PublicBodyClass = "home-landing";

    var featuredJobsSource = (Model.TinTuyenDungMoiNhat ?? Enumerable.Empty<PublicJobCardViewModel>()).Take(48).ToList();
    var featuredJobs = featuredJobsSource
        .Select((job, index) => new { Job = job, Sort = (index * 7) % Math.Max(1, featuredJobsSource.Count), Index = index })
        .OrderBy(x => x.Sort)
        .ThenBy(x => x.Index)
        .Select(x => x.Job)
        .ToList();
    var jobsPerPage = 12;
    var totalJobPages = Math.Max(1, (int)Math.Ceiling(featuredJobs.Count / (double)jobsPerPage));
    var featuredEmployers = (Model.NhaTuyenDungTieuBieu ?? Enumerable.Empty<FeaturedEmployerViewModel>()).ToList();
    var employerCards = featuredEmployers.Take(12).ToList();

    var featuredCategories = (Model.NganhNgheNoiBat ?? Enumerable.Empty<PublicHomeCategoryViewModel>()).Take(8).ToList();
    var quickCategories = featuredCategories.Take(3).ToList();
    var categoryIcons = new[] { "bi-code-square", "bi-bar-chart-line", "bi-briefcase", "bi-megaphone", "bi-people", "bi-headset", "bi-gear", "bi-calculator" };
    var testimonials = new[]
    {
        new { Name = "Minh Anh", Company = "Ứng viên Marketing", Avatar = "~/Content/Jobentry/img/testimonial-1.jpg", Text = "Mình hay lọc theo ngành rồi lưu lại vài tin phù hợp. Thông tin lương và địa điểm rõ nên đỡ mất thời gian mở từng tin." },
        new { Name = "Quốc Huy", Company = "Sales Executive", Avatar = "~/Content/Jobentry/img/testimonial-2.jpg", Text = "Giao diện danh sách việc khá dễ lướt. Mình nộp CV xong theo dõi trạng thái đơn luôn, không phải ghi chú riêng như trước." },
        new { Name = "Hoàng Nam", Company = "Lập trình viên .NET", Avatar = "~/Content/Jobentry/img/testimonial-3.jpg", Text = "Phần lọc theo địa điểm và loại hình làm việc giúp mình tìm job hybrid nhanh hơn. Tin nào còn hạn nhìn cũng khá rõ." },
        new { Name = "Thanh Trúc", Company = "Kế toán tổng hợp", Avatar = "~/Content/Jobentry/img/testimonial-4.jpg", Text = "Mình thích cách công ty và vị trí được trình bày gọn. Không bị quá nhiều chữ nên xem trên điện thoại cũng ổn." },
        new { Name = "Gia Bảo", Company = "HR Intern", Avatar = "~/Content/Jobentry/img/testimonial-1.jpg", Text = "Các ngành nghề được chia dễ hiểu. Với người mới đi tìm việc như mình thì vào trang là biết nên bắt đầu từ đâu." },
        new { Name = "Ngọc Linh", Company = "Nhân viên văn phòng", Avatar = "~/Content/Jobentry/img/testimonial-2.jpg", Text = "Nộp hồ sơ khá gọn. Mình xem lại các đơn đã gửi được nên cảm giác chủ động hơn." }
    };
    var employerRuntimeLogos = new List<Tuple<string, string>>();
    var employerLogoFolder = Server.MapPath("~/Content/Jobentry/img/employers/");
    var employerLogoExtensions = new[] { ".png", ".jpg", ".jpeg", ".webp", ".svg" };
    if (!string.IsNullOrWhiteSpace(employerLogoFolder) && Directory.Exists(employerLogoFolder))
    {
        employerRuntimeLogos = Directory.EnumerateFiles(employerLogoFolder)
            .Where(file => employerLogoExtensions.Contains(Path.GetExtension(file), StringComparer.OrdinalIgnoreCase))
            .Where(file =>
            {
                var logoName = Path.GetFileNameWithoutExtension(file).ToLowerInvariant();
                return !logoName.Contains("shopee")
                    && !logoName.Contains("lazada")
                    && !logoName.Contains("honda")
                    && !logoName.Contains("yamaha");
            })
            .OrderBy(file => Path.GetFileName(file))
            .Select(file => Tuple.Create(Path.GetFileNameWithoutExtension(file), Url.Content("~/Content/Jobentry/img/employers/" + Path.GetFileName(file))))
            .ToList();
    }
}

@functions {
    private string CompactSalary(string salary)
    {
        if (string.IsNullOrWhiteSpace(salary) || salary.IndexOf("Thỏa thuận", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "Thỏa thuận";
        }

        var matches = System.Text.RegularExpressions.Regex.Matches(salary, @"\d[\d\.,]*");
        if (matches.Count >= 2)
        {
            return string.Format("{0}-{1} triệu", ToMillionText(matches[0].Value), ToMillionText(matches[1].Value));
        }

        if (matches.Count == 1)
        {
            var prefix = salary.StartsWith("Đến", StringComparison.OrdinalIgnoreCase) ? "Đến " : salary.StartsWith("Từ", StringComparison.OrdinalIgnoreCase) ? "Từ " : string.Empty;
            return string.Format("{0}{1} triệu", prefix, ToMillionText(matches[0].Value));
        }

        return salary;
    }

    private string ToMillionText(string value)
    {
        decimal amount;
        var normalized = value.Replace(".", string.Empty).Replace(",", string.Empty);
        if (!decimal.TryParse(normalized, out amount))
        {
            return value;
        }

        var million = Math.Floor(amount / 1000000m);
        return million.ToString("0");
    }
}


                .home-landing .job-card-main h3 a {
                    color: inherit;
                    text-decoration: none;
                }

                    .home-landing .job-card-main h3 a:hover {
                        color: #111827;
                        text-decoration: underline;
                        text-underline-offset: 3px;
                    }

                .home-landing .job-card-company {
                    display: block;
                    overflow: hidden;
                    color: #657883;
                    font-size: .73rem;
                    font-weight: 500;
                    text-decoration: none;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

                    .home-landing .job-card-company:hover {
                        color: #111827;
                        text-decoration: underline;
                        text-underline-offset: 3px;
                    }

            .home-landing .job-meta-list {
                display: flex;
                flex-wrap: nowrap;
                gap: 5px;
                min-width: 0;
                margin-top: 0;
                margin-bottom: 0;
            }

            .home-landing .job-meta-pill {
                display: inline-flex;
                align-items: center;
                min-height: 22px;
                max-width: 100%;
                padding: 4px 7px;
                border-radius: 5px;
                background: #f6f8fa;
                color: #5f7078;
                font-size: .68rem;
                font-weight: 600;
                line-height: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .home-landing .job-card-bottom {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                margin-left: 56px;
                padding-top: 0;
                border-top: 0;
            }

            .home-landing .job-card-salary {
                color: #4f636e;
                font-size: .68rem;
                font-weight: 600;
                white-space: nowrap;
            }

            .home-landing .job-card-deadline {
                display: none;
                margin-top: 3px;
                color: #7b8d96;
                font-size: .66rem;
                white-space: nowrap;
            }

            .home-landing .job-card-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                border-radius: 0;
                background: transparent;
                color: #111827;
                font-size: .7rem;
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
            }

                .home-landing .job-card-button:hover {
                    background: transparent;
                    color: #4b5563;
                    text-decoration: underline;
                }

            .home-landing .featured-job-card.is-hidden {
                display: none;
            }

            .home-landing .job-pager {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                margin-top: 15px;
            }

            .home-landing .job-pager-button {
                width: 26px;
                height: 26px;
                border: 1px solid #d9e3e9;
                border-radius: 50%;
                background: transparent;
                color: #58707b;
                font-size: .86rem;
                font-weight: 700;
                line-height: 1;
            }

                .home-landing .job-pager-button:hover,
                .home-landing .job-pager-button:focus {
                    border-color: #9ca3af;
                    color: #111827;
                }

                .home-landing .job-pager-button.is-active {
                    border-color: #111827;
                    background: #111827;
                    color: #ffffff;
                }

                .home-landing .job-pager-button:disabled {
                    cursor: not-allowed;
                    opacity: .45;
                }

            .home-landing .job-pager-dot {
                width: 7px;
                height: 7px;
                padding: 0;
                border: 0;
                border-radius: 999px;
                background: #c8d3da;
                line-height: 1;
                transition: width .16s ease, background .16s ease;
            }

                .home-landing .job-pager-dot.is-active {
                    width: 18px;
                    background: #111827;
                }

            .home-landing .employer-carousel {
                position: relative;
                margin-top: 28px;
                margin-bottom: 20px;
                padding: 0 42px 4px;
            }

            .home-landing .employer-carousel-viewport {
                overflow: hidden;
                padding-top: 40px;
            }

            .home-landing .employer-grid {
                display: flex;
                gap: 20px;
                margin-bottom: 0;
                transition: transform .24s ease;
                will-change: transform;
            }

            .home-landing .employer-carousel-button {
                position: absolute;
                top: calc(50% + 20px);
                z-index: 2;
                width: 30px;
                height: 42px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #d9e1e7;
                border-radius: 10px;
                background: #ffffff;
                color: #111827;
                font-size: 1rem;
                line-height: 1;
                transform: translateY(-50%);
                transition: border-color .16s ease, background .16s ease, color .16s ease;
            }

                .home-landing .employer-carousel-button:hover,
                .home-landing .employer-carousel-button:focus {
                    border-color: #aeb8c2;
                    background: #f5f6f8;
                    color: #000000;
                }

                .home-landing .employer-carousel-button:disabled {
                    cursor: not-allowed;
                    opacity: .35;
                }

                .home-landing .employer-carousel-button.is-prev {
                    left: 0;
                }

                .home-landing .employer-carousel-button.is-next {
                    right: 0;
                }

            .home-landing .employer-card {
                position: relative;
                min-height: 152px;
                height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 14px;
                padding: 52px 18px 18px;
                border-radius: 10px;
                background: #fbfefd;
                border: 1px solid #e3eee8;
                box-shadow: none;
                overflow: visible;
                text-decoration: none;
                transition: transform .18s ease, border-color .18s ease, background .18s ease;
                flex: 0 0 calc((100% - 60px) / 4);
            }

                .home-landing .employer-card:hover {
                    transform: translateY(-2px);
                    border-color: #ccdcd3;
                    background: #ffffff;
                }

            .home-landing .employer-logo {
                position: absolute;
                top: -36px;
                left: 50%;
                width: 74px;
                height: 74px;
                flex: 0 0 74px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: #ffffff;
                border: 1px solid #e2e8ee;
                box-shadow: 0 8px 20px rgba(17, 24, 39, .06);
                overflow: hidden;
                transform: translateX(-50%);
            }

                .home-landing .employer-logo img {
                    width: 118%;
                    height: 118%;
                    object-fit: contain;
                    background: #ffffff;
                }

                .home-landing .employer-logo.is-new-logo img {
                    width: 132%;
                    height: 132%;
                    transform: scale(1.08);
                }

            .home-landing .employer-logo-fallback {
                color: #111827;
                font-size: 1.2rem;
                font-weight: 800;
            }

            .home-landing .employer-card h3 {
                margin: 0;
                overflow: hidden;
                color: #111827;
                font-size: .96rem;
                font-weight: 700;
                line-height: 1.38;
                text-align: center;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
            }

            .home-landing .employer-count-pill {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 30px;
                padding: 7px 13px;
                border-radius: 7px;
                background: #eef3fb;
                color: #2b5fae;
                font-size: .86rem;
                font-weight: 600;
                line-height: 1;
            }

            .home-landing .employer-logo-strip {
                position: relative;
                overflow: hidden;
                margin-top: 18px;
                padding: 2px 0;
            }

                .home-landing .employer-logo-strip::before,
                .home-landing .employer-logo-strip::after {
                    position: absolute;
                    top: 0;
                    bottom: 0;
                    z-index: 2;
                    width: 80px;
                    content: "";
                    pointer-events: none;
                }

                .home-landing .employer-logo-strip::before {
                    left: 0;
                    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
                }

                .home-landing .employer-logo-strip::after {
                    right: 0;
                    background: linear-gradient(270deg, #ffffff 0%, rgba(255, 255, 255, 0) 100%);
                }

            .home-landing .employer-logo-track {
                display: flex;
                align-items: center;
                gap: 12px;
                width: max-content;
                animation: employerLogoStripDrift 54s linear infinite;
                will-change: transform;
            }

            .home-landing .employer-logo-strip:hover .employer-logo-track {
                animation-play-state: paused;
            }

            .home-landing .employer-logo-chip {
                width: 194px;
                height: 92px;
                flex: 0 0 auto;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 6px 10px;
                border-radius: 14px;
                background: #ffffff;
                border: 1px solid #e1e9ef;
                box-shadow: none;
                overflow: hidden;
                transition: border-color .16s ease, background .16s ease;
            }

                .home-landing .employer-logo-chip.is-small {
                    width: 176px;
                    height: 86px;
                }

                .home-landing .employer-logo-chip.is-large {
                    width: 216px;
                    height: 98px;
                }

                .home-landing .employer-logo-chip:hover {
                    background: #fbfdfe;
                    border-color: #cbd8df;
                }

                .home-landing .employer-logo-chip img {
                    max-width: 142%;
                    max-height: 98px;
                    object-fit: contain;
                    filter: saturate(.98);
                }

                .home-landing .employer-logo-chip.is-large img {
                    max-height: 106px;
                }

                .home-landing .employer-logo-chip.is-mobifone img {
                    max-width: 105%;
                    max-height: 72px;
                }

                .home-landing .employer-logo-chip.is-new-logo img {
                    max-width: 194%;
                    max-height: 136px;
                    transform: scale(1.24);
                }

            @@keyframes employerLogoStripDrift {
                from {
                    transform: translateX(0);
                }

                to {
                    transform: translateX(-50%);
                }
            }

            .home-landing .category-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 18px;
            }

            .home-landing .category-card {
                min-height: 176px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 12px;
                padding: 26px 20px;
                border-radius: 12px;
                background: #f8fafc;
                border: 1px solid #e6edf2;
                box-shadow: none;
                text-decoration: none;
                text-align: center;
                transition: border-color .18s ease, background .18s ease, transform .18s ease;
            }

                .home-landing .category-card:hover {
                    border-color: #cbd8df;
                    background: #ffffff;
                    transform: translateY(-2px);
                }

            .home-landing .category-icon {
                width: 72px;
                height: 72px;
                flex: 0 0 72px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 18px;
                background: transparent;
                color: #1f2933;
                font-size: 2.25rem;
            }

            .home-landing .category-card h3 {
                width: 100%;
                margin: 0;
                overflow: hidden;
                color: #102331;
                font-size: .98rem;
                font-weight: 800;
                line-height: 1.35;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .home-landing .category-card p {
                margin: 0;
                color: #4b5563;
                font-size: .88rem;
                font-weight: 700;
                line-height: 1.2;
            }

            .home-landing .testimonial-section {
                position: relative;
                overflow: hidden;
                background: #ffffff;
            }

                .home-landing .testimonial-section .section-heading-row {
                    margin-bottom: 26px;
                }

                .home-landing .testimonial-section .section-heading {
                    font-size: clamp(1.55rem, 2.2vw, 2.1rem);
                }

            .home-landing .testimonial-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 20px;
            }

            .home-landing .testimonial-card {
                position: relative;
                min-height: 260px;
                display: grid;
                grid-template-rows: 1fr auto;
                gap: 28px;
                padding: 28px 30px;
                border-radius: 14px;
                background: #ffffff;
                border: 1px solid #e5eaee;
                box-shadow: 0 10px 28px rgba(8, 35, 48, .035);
                transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
            }

                .home-landing .testimonial-card:hover,
                .home-landing .testimonial-card:focus-within {
                    border-color: #cfdbe3;
                    box-shadow: 0 18px 36px rgba(8, 35, 48, .07);
                    transform: translateY(-4px);
                }

                .home-landing .testimonial-card p {
                    margin: 0;
                    color: #1f2c35;
                    font-size: .98rem;
                    line-height: 1.68;
                }

            .home-landing .testimonial-person {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 18px;
            }

            .home-landing .testimonial-person strong {
                display: block;
                color: #102331;
                font-size: .88rem;
                font-weight: 800;
                line-height: 1.35;
            }

            .home-landing .testimonial-person span {
                display: block;
                margin-top: 4px;
                color: #8a969e;
                font-size: .78rem;
                font-weight: 600;
            }

            .home-landing .testimonial-avatar {
                width: 58px;
                height: 58px;
                flex: 0 0 58px;
                border-radius: 50%;
                object-fit: cover;
                background: #eef3f6;
            }

            .home-landing .public-nav-links .nav-link::after {
                display: none;
            }

            .home-landing .btn-nav-register {
                background: #f8fafc;
                border-color: #f8fafc;
                color: #142632 !important;
                box-shadow: none;
            }

                .home-landing .btn-nav-register:hover,
                .home-landing .btn-nav-register:focus {
                    background: #eaf4f8;
                    border-color: #d8eaf1;
                    color: #102331 !important;
                }

            .home-landing .btn-nav-login:hover,
            .home-landing .btn-nav-account:hover,
            .home-landing .btn-nav-login:focus,
            .home-landing .btn-nav-account:focus {
                transform: none;
            }

        @@media (max-width: 1199.98px) {
            .home-landing .hero-copy h1 {
                font-size: clamp(2.5rem, 4vw, 4rem);
            }

            .home-landing .hero-search-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .home-landing .hero-search-button {
                grid-column: span 2;
            }

            .home-landing .job-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .home-landing .employer-card {
                flex-basis: calc((100% - 20px) / 2);
            }

            .home-landing .testimonial-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .home-landing .employer-logo-chip {
                width: 166px;
                height: 80px;
            }

            .home-landing .employer-logo-chip.is-small {
                width: 152px;
                height: 76px;
            }

            .home-landing .employer-logo-chip.is-large {
                width: 184px;
                height: 84px;
            }

            .home-landing .category-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .home-landing .public-navbar {
                padding-left: 0;
                padding-right: 0;
            }

            .home-landing .home-hero {
                min-height: 423px;
                padding-top: 74px;
                padding-bottom: 82px;
            }

            .home-landing .hero-side {
                padding-left: 0;
                margin-top: 18px;
            }

            .home-landing .section-block {
                padding: 68px 0;
            }
        }

        @@media (max-width: 767.98px) {
            .home-landing .home-hero {
                min-height: 387px;
                padding-top: 62px;
                padding-bottom: 70px;
            }

            .home-landing .hero-copy h1 {
                font-size: 2.4rem;
                white-space: normal;
            }

            .home-landing .hero-copy p {
                font-size: 1rem;
            }

            .home-landing .hero-search-grid {
                grid-template-columns: 1fr;
            }

            .home-landing .hero-search-button {
                grid-column: auto;
            }

            .home-landing .section-heading-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .home-landing .job-grid,
            .home-landing .testimonial-grid,
            .home-landing .category-grid {
                grid-template-columns: 1fr;
            }

            .home-landing .employer-carousel {
                padding: 0 28px;
            }

            .home-landing .employer-card {
                flex-basis: 100%;
            }

            .home-landing .testimonial-card {
                min-height: 230px;
                padding: 24px;
            }

            .home-landing .employer-logo-strip::before,
            .home-landing .employer-logo-strip::after {
                width: 40px;
            }

            .home-landing .employer-logo-track {
                gap: 8px;
                animation-duration: 46s;
            }

            .home-landing .employer-logo-chip,
            .home-landing .employer-logo-chip.is-large {
                width: 148px;
                height: 72px;
                padding: 5px 8px;
                border-radius: 12px;
            }

            .home-landing .employer-logo-chip.is-small {
                width: 138px;
                height: 68px;
            }

            .home-landing .employer-logo-chip img,
            .home-landing .employer-logo-chip.is-large img {
                max-width: 138%;
                max-height: 76px;
            }

            .home-landing .employer-logo-chip.is-mobifone img {
                max-width: 104%;
                max-height: 58px;
            }

            .home-landing .employer-logo-chip.is-new-logo img {
                max-width: 176%;
                max-height: 104px;
                transform: scale(1.18);
            }

            .home-landing .job-card-bottom {
                align-items: flex-start;
                flex-direction: column;
            }

            .home-landing .job-card-button {
                width: auto;
            }

            .home-landing .featured-job-card {
                display: flex;
                flex-direction: column;
            }

            .home-landing .job-card-bottom {
                align-items: flex-start;
                flex-direction: row;
                margin-left: 0;
                padding-top: 0;
                border-top: 0;
            }

            .home-landing .job-meta-list {
                margin-top: 0;
            }
        }
    </style>
}

<section class="home-hero">
    <div class="container">
        <div class="row g-5 hero-grid">
            <div class="col-lg-6">
                <div class="hero-copy">
                    <h1>Khám phá công việc dành cho bạn</h1>
                    <p>
                        Mọi ngành nghề. Mọi địa điểm. Mọi cấp độ kinh nghiệm.
                    </p>

                    <div class="hero-search-panel">
                        @using (Html.BeginForm("Index", "Job", FormMethod.Get))
                        {
                            <div class="hero-search-grid">
                                <div class="hero-search-field">
                                    <i class="bi bi-search"></i>
                                    <input type="text" name="keyword" class="form-control" placeholder="Từ khóa công việc" value="@Model.Keyword" />
                                </div>
                                <div class="hero-search-field">
                                    <i class="bi bi-list"></i>
                                    <input type="hidden" name="nganhNgheId" id="homeIndustryId" />
                                    <div class="dropdown hero-search-dropdown w-100">
                                        <button class="btn dropdown-toggle hero-filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-default-label="Ngành nghề">
                                            <span>Ngành nghề</span>
                                        </button>
                                        <div class="dropdown-menu hero-filter-menu">
                                            <button class="dropdown-item active" type="button" data-target="homeIndustryId" data-value="" data-label="Ngành nghề">Tất cả ngành nghề</button>
                                            @foreach (var option in Model.NganhNgheOptions)
                                            {
                                                <button class="dropdown-item" type="button" data-target="homeIndustryId" data-value="@option.Value" data-label="@option.Text">@option.Text</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="hero-search-field">
                                    <i class="bi bi-geo-alt"></i>
                                    <input type="hidden" name="diaDiemId" id="homeLocationId" />
                                    <div class="dropdown hero-search-dropdown w-100">
                                        <button class="btn dropdown-toggle hero-filter-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-default-label="Địa điểm">
                                            <span>Địa điểm</span>
                                        </button>
                                        <div class="dropdown-menu hero-filter-menu">
                                            <button class="dropdown-item active" type="button" data-target="homeLocationId" data-value="" data-label="Địa điểm">Tất cả địa điểm</button>
                                            @foreach (var option in Model.DiaDiemOptions)
                                            {
                                                <button class="dropdown-item" type="button" data-target="homeLocationId" data-value="@option.Value" data-label="@option.Text">@option.Text</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <button type="submit" class="hero-search-button">Tìm kiếm</button>
                            </div>
                        }

                        @if (quickCategories.Any())
                        {
                            <div class="hero-quick-links">
                                @foreach (var category in quickCategories)
                                {
                                    <a href="@Url.Action("Index", "Job", new { nganhNgheId = category.NganhNgheId })">@category.TenNganhNghe</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-side">
                    <div class="hero-surface">
                        <div class="hero-surface-header">
                            <div>
                                <span>Tổng quan</span>
                                <h3>Dữ liệu cần thiết, không rối mắt.</h3>
                            </div>
                            <span class="hero-surface-chip">Đang mở</span>
                        </div>

                        <div class="hero-metric-grid">
                            <div class="hero-metric-card">
                                <strong>@featuredJobs.Count</strong>
                                <span>Việc nổi bật</span>
                            </div>
                            <div class="hero-metric-card">
                                <strong>@featuredCategories.Count</strong>
                                <span>Ngành đang tuyển</span>
                            </div>
                        </div>

                        <div class="hero-signal-list">
                            <div class="hero-signal-item">
                                <i class="bi bi-patch-check"></i>
                                <div>
                                    Tin đã duyệt
                                    <small>Chỉ ưu tiên những cơ hội còn hạn và đủ dữ liệu</small>
                                </div>
                            </div>

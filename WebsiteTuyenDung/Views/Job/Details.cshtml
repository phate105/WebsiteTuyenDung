@using System.Linq
@model WebsiteTuyenDung.Models.ViewModels.JobDetailsViewModel
@{
    ViewBag.Title = Model.TinTuyenDung.TieuDe;
    ViewBag.PublicBodyClass = "job-area";

    var tin = Model.TinTuyenDung;
    var companyName = tin.HoSoCongTy != null && !string.IsNullOrWhiteSpace(tin.HoSoCongTy.TenCongTy)
        ? tin.HoSoCongTy.TenCongTy
        : "Doanh nghiệp";
    var companyInitial = companyName.Substring(0, 1).ToUpper();
    var logoUrl = tin.HoSoCongTy != null ? tin.HoSoCongTy.Logo : null;
    var diaDiem = tin.DiaDiem != null ? tin.DiaDiem.TenDiaDiem : "Chưa cập nhật";
    var loaiHinh = tin.LoaiHinhLamViec != null ? tin.LoaiHinhLamViec.TenLoaiHinhLamViec : "Chưa cập nhật";
    var nganhNghe = tin.NganhNghe != null ? tin.NganhNghe.TenNganhNghe : "Chưa cập nhật";
    var kinhNghiem = tin.CapDoKinhNghiem != null ? tin.CapDoKinhNghiem.TenCapDoKinhNghiem : "Chưa cập nhật";
    var ngayDang = tin.NgayDang.HasValue ? tin.NgayDang.Value.ToString("dd/MM/yyyy") : tin.NgayTao.ToString("dd/MM/yyyy");
    var luongHienThi = "Thỏa thuận";

    if (tin.LuongToiThieu.HasValue && tin.LuongToiDa.HasValue)
    {
        luongHienThi = string.Format("{0:#,##0} - {1:#,##0} VNĐ", tin.LuongToiThieu.Value, tin.LuongToiDa.Value);
    }
    else if (tin.LuongToiThieu.HasValue)
    {
        luongHienThi = string.Format("Từ {0:#,##0} VNĐ", tin.LuongToiThieu.Value);
    }
    else if (tin.LuongToiDa.HasValue)
    {
        luongHienThi = string.Format("Đến {0:#,##0} VNĐ", tin.LuongToiDa.Value);
    }
}

@section styles {
    <style>
        .job-detail-page {
            background: #f4f6f8;
            color: #111827;
        }

        .job-detail-hero {
            padding: 28px 0 30px;
            background: #25292e;
        }

        .job-detail-inner {
            max-width: 1180px;
            margin: 0 auto;
        }

        .job-back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            color: rgba(255, 255, 255, .82);
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
        }

        .job-back-link:hover,
        .job-back-link:focus {
            color: #ffffff;
        }

        .job-detail-head {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 24px;
            padding: 24px;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 8px;
            background: rgba(255, 255, 255, .98);
        }

        .job-detail-main-info {
            display: flex;
            gap: 16px;
            min-width: 0;
        }

        .job-detail-logo,
        .job-detail-logo-fallback {
            width: 72px;
            height: 72px;
            flex: 0 0 72px;
            border: 1px solid #e2e8ee;
            border-radius: 6px;
            background: #ffffff;
            object-fit: contain;
        }

        .job-detail-logo-fallback {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #d72626;
            font-size: 24px;
            font-weight: 700;
        }

        .job-detail-company {
            display: inline-block;
            margin-bottom: 6px;
            color: #4b5563;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
        }

        .job-detail-company:hover {
            color: #111827;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .job-detail-title {
            margin: 0 0 10px;
            color: #101820;
            font-size: clamp(26px, 3vw, 38px);
            font-weight: 700;
            line-height: 1.16;
            letter-spacing: -.045em;
        }

        .job-detail-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .job-detail-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 26px;
            padding: 0 10px;
            border-radius: 4px;
            background: #f0f2f4;
            color: #33404a;
            font-size: 12px;
            font-weight: 400;
        }

        .job-detail-actions {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding-top: 4px;
        }

        .job-detail-primary,
        .job-detail-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 38px;
            padding: 0 18px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }

        .job-detail-primary {
            border: 1px solid #27313a;
            background: #27313a;
            color: #ffffff;
        }

        .job-detail-primary:hover,
        .job-detail-primary:focus {
            color: #ffffff;
            background: #161d23;
            border-color: #161d23;
        }

        .job-detail-secondary {
            border: 1px solid #d4dde4;
            color: #27313a;
            background: #ffffff;
        }

        .job-detail-secondary:hover,
        .job-detail-secondary:focus {
            color: #111827;
            border-color: #b9c5ce;
            background: #f7f9fb;
        }

        .job-detail-content {
            padding: 30px 0 72px;
        }

        .job-panel {
            border: 1px solid #e1e6ea;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 1px 2px rgba(17, 24, 39, .03);
        }

        .job-panel + .job-panel {
            margin-top: 18px;
        }

        .job-panel-header {
            padding: 18px 20px;
            border-bottom: 1px solid #edf1f4;
        }

        .job-panel-header h2,
        .job-panel-header h3 {
            margin: 0;
            color: #101820;
            font-size: 18px;
            font-weight: 650;
            letter-spacing: -.02em;
        }

        .job-panel-body {
            padding: 20px;
        }

        .job-copy {
            color: #33404a;
            font-size: 14px;
            line-height: 1.75;
            white-space: pre-line;
        }

        .job-summary-list {
            display: grid;
            gap: 14px;
        }

        .job-summary-row {
            display: grid;
            grid-template-columns: 26px minmax(0, 1fr);
            gap: 10px;
            align-items: start;
        }

        .job-summary-row i {
            color: #d72626;
            font-size: 15px;
            line-height: 1.5;
        }

        .job-summary-label {
            color: #7a8791;
            font-size: 12px;
            line-height: 1.25;
        }

        .job-summary-value {
            margin-top: 2px;
            color: #111827;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.4;
        }

        .job-apply-note {
            margin: 0;
            padding: 14px;
            border: 1px solid #d9e3ea;
            border-radius: 6px;
            background: #f7fafc;
            color: #34404a;
            font-size: 14px;
            line-height: 1.6;
        }

        .job-apply-note a {
            color: #d72626;
            font-weight: 600;
        }

        .job-form-label {
            color: #34404a;
            font-size: 13px;
            font-weight: 500;
        }

        .job-form-control {
            border: 1px solid #d8e0e6;
            border-radius: 6px;
            color: #20272d;
            font-size: 14px;
            box-shadow: none !important;
        }

        .job-form-control:focus {
            border-color: #9eb0bd;
        }

        .job-company-description {
            margin: 0;
            color: #53616c;
            font-size: 14px;
            line-height: 1.65;
            white-space: pre-line;
        }

        .job-related-list {
            display: grid;
            gap: 12px;
        }

        .job-related-card {
            display: grid;
            grid-template-columns: 44px minmax(0, 1fr);
            gap: 12px;
            padding: 14px;
            border: 1px solid #e5ebef;
            border-radius: 6px;
            background: #ffffff;
            color: inherit;
            text-decoration: none;
        }

        .job-related-card:hover,
        .job-related-card:focus {
            color: inherit;
            border-color: #b9c5ce;
            background: #fbfcfd;
        }

        .job-related-logo,
        .job-related-logo-fallback {
            width: 44px;
            height: 44px;
            border: 1px solid #e5ebef;
            border-radius: 4px;
            object-fit: contain;
            background: #ffffff;
        }

        .job-related-logo-fallback {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #d72626;
            font-weight: 700;
        }

        .job-related-title {
            display: -webkit-box;
            overflow: hidden;
            margin-bottom: 4px;
            color: #101820;
            font-size: 14px;
            font-weight: 650;
            line-height: 1.35;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .job-related-meta {
            color: #65727d;
            font-size: 12px;
        }

        @@media (max-width: 991.98px) {
            .job-detail-head {
                grid-template-columns: 1fr;
            }

            .job-detail-actions {
                padding-top: 0;
            }
        }

        @@media (max-width: 575.98px) {
            .job-detail-main-info {
                display: block;
            }

            .job-detail-logo,
            .job-detail-logo-fallback {
                margin-bottom: 14px;
            }

            .job-detail-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .job-detail-primary,
            .job-detail-secondary {
                width: 100%;
            }
        }
    </style>
}

<main class="job-detail-page">
    <section class="job-detail-hero">
        <div class="container">
            <div class="job-detail-inner">
                <a class="job-back-link" href="@Url.Action("Index", "Job")">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại danh sách việc làm
                </a>

                <div class="job-detail-head">
                    <div class="job-detail-main-info">
                        @if (!string.IsNullOrWhiteSpace(logoUrl))
                        {
                            <img class="job-detail-logo" src="@Url.Content(logoUrl)" alt="@companyName" />
                        }
                        else
                        {
                            <div class="job-detail-logo-fallback">@companyInitial</div>
                        }

                        <div>
                            <a class="job-detail-company" href="@Url.Action("Company", "Job", new { id = tin.HoSoCongTyId })">@companyName</a>
                            <h1 class="job-detail-title">@tin.TieuDe</h1>
                            <div class="job-detail-meta">
                                <span class="job-detail-chip"><i class="bi bi-geo-alt"></i>@diaDiem</span>
                                <span class="job-detail-chip"><i class="bi bi-clock"></i>@loaiHinh</span>
                                <span class="job-detail-chip"><i class="bi bi-cash-stack"></i>@luongHienThi</span>
                                <span class="job-detail-chip"><i class="bi bi-calendar2-check"></i>Hạn nộp @tin.HanNopHoSo.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="job-detail-actions">
                        <a class="job-detail-secondary" href="@Url.Action("Index", "Job", new { nganhNgheId = tin.NganhNgheId })">Việc cùng ngành</a>
                        <a class="job-detail-primary" href="#apply-box">Ứng tuyển</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="job-detail-content">
        <div class="container">
            <div class="job-detail-inner">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <section class="job-panel">
                            <div class="job-panel-header">
                                <h2>Mô tả công việc</h2>
                            </div>
                            <div class="job-panel-body">
                                <div class="job-copy">@tin.MoTaCongViec</div>
                            </div>
                        </section>

                        <section class="job-panel">
                            <div class="job-panel-header">
                                <h2>Yêu cầu ứng viên</h2>
                            </div>
                            <div class="job-panel-body">
                                <div class="job-copy">@(string.IsNullOrWhiteSpace(tin.YeuCau) ? "Nhà tuyển dụng sẽ trao đổi thêm khi phỏng vấn." : tin.YeuCau)</div>
                            </div>
                        </section>

                        <section class="job-panel">
                            <div class="job-panel-header">
                                <h2>Quyền lợi</h2>
                            </div>
                            <div class="job-panel-body">
                                <div class="job-copy">@(string.IsNullOrWhiteSpace(tin.QuyenLoi) ? "Thông tin quyền lợi sẽ được cập nhật trong quá trình trao đổi." : tin.QuyenLoi)</div>
                            </div>
                        </section>

                        <section id="apply-box" class="job-panel">
                            <div class="job-panel-header">
                                <h2>Ứng tuyển vị trí này</h2>
                            </div>
                            <div class="job-panel-body">
                                @if (!Model.IsAuthenticated)
                                {
                                    <p class="job-apply-note mb-3">@Model.ApplyMessage</p>
                                    <a href="@Url.Action("Login", "Account", new { ReturnUrl = Request.RawUrl })" class="job-detail-primary">Đăng nhập để ứng tuyển</a>
                                }
                                else if (!Model.IsCandidate || !Model.CoTheUngTuyen || !Model.HasProfile || !Model.HasCv || Model.AlreadyApplied)
                                {
                                    <div class="job-apply-note">
                                        @Model.ApplyMessage
                                        @if (Model.IsCandidate && !Model.HasProfile)
                                        {
                                            <div class="mt-2"><a href="@Url.Action("HoSo", "UngVien")">Đi tới hồ sơ cá nhân</a></div>
                                        }
                                        else if (Model.IsCandidate && Model.HasProfile && !Model.HasCv)
                                        {
                                            <div class="mt-2"><a href="@Url.Action("CV", "UngVien")">Đi tới quản lý CV</a></div>
                                        }
                                        else if (Model.AlreadyApplied)
                                        {
                                            <div class="mt-2"><a href="@Url.Action("DonUngTuyen", "UngVien")">Xem các đơn đã nộp</a></div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    using (Html.BeginForm("Apply", "Job", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.HiddenFor(m => m.ApplyForm.TinTuyenDungId)
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label class="form-label job-form-label">Chọn CV</label>
                                                @Html.DropDownListFor(m => m.ApplyForm.CVUngVienId, Model.CvOptions, "-- Chọn CV --", new { @class = "form-select job-form-control" })
                                                @Html.ValidationMessageFor(m => m.ApplyForm.CVUngVienId, "", new { @class = "text-danger small" })
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label job-form-label">Thư giới thiệu</label>
                                                @Html.TextAreaFor(m => m.ApplyForm.ThuGioiThieu, new { @class = "form-control job-form-control", rows = 4, placeholder = "Viết ngắn gọn lý do bạn phù hợp với vị trí này" })
                                            </div>
                                            <div class="col-12">
                                                <button class="job-detail-primary border-0" type="submit">Nộp hồ sơ ngay</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </section>
                    </div>

                    <div class="col-lg-4">
                        <aside class="job-panel">
                            <div class="job-panel-header">
                                <h3>Tóm tắt việc làm</h3>
                            </div>
                            <div class="job-panel-body">
                                <div class="job-summary-list">
                                    <div class="job-summary-row">
                                        <i class="bi bi-calendar3"></i>
                                        <div>
                                            <div class="job-summary-label">Ngày đăng</div>
                                            <div class="job-summary-value">@ngayDang</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-people"></i>
                                        <div>
                                            <div class="job-summary-label">Số lượng tuyển</div>
                                            <div class="job-summary-value">@tin.SoLuongTuyen vị trí</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-briefcase"></i>
                                        <div>
                                            <div class="job-summary-label">Ngành nghề</div>
                                            <div class="job-summary-value">@nganhNghe</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-clock"></i>
                                        <div>
                                            <div class="job-summary-label">Loại hình</div>
                                            <div class="job-summary-value">@loaiHinh</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-bar-chart"></i>
                                        <div>
                                            <div class="job-summary-label">Kinh nghiệm</div>
                                            <div class="job-summary-value">@kinhNghiem</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-cash-stack"></i>
                                        <div>
                                            <div class="job-summary-label">Mức lương</div>
                                            <div class="job-summary-value">@luongHienThi</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-geo-alt"></i>
                                        <div>
                                            <div class="job-summary-label">Địa điểm</div>
                                            <div class="job-summary-value">@diaDiem</div>
                                        </div>
                                    </div>
                                    <div class="job-summary-row">
                                        <i class="bi bi-calendar2-check"></i>
                                        <div>
                                            <div class="job-summary-label">Hạn nộp</div>
                                            <div class="job-summary-value">@tin.HanNopHoSo.ToString("dd/MM/yyyy")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </aside>

                        <aside class="job-panel">
                            <div class="job-panel-header">
                                <h3>Thông tin công ty</h3>
                            </div>
                            <div class="job-panel-body">
                                <h4 class="mb-2 fs-6 fw-semibold">@companyName</h4>
                                <p class="job-company-description">@(tin.HoSoCongTy == null || string.IsNullOrWhiteSpace(tin.HoSoCongTy.MoTa) ? "Doanh nghiệp chưa bổ sung mô tả chi tiết." : tin.HoSoCongTy.MoTa)</p>
                                @if (tin.HoSoCongTy != null && !string.IsNullOrWhiteSpace(tin.HoSoCongTy.Website))
                                {
                                    <div class="mt-3">
                                        <a href="@tin.HoSoCongTy.Website" target="_blank" rel="noopener" class="job-detail-secondary">Website công ty</a>
                                    </div>
                                }
                            </div>
                        </aside>

                        @if (Model.RelatedJobs != null && Model.RelatedJobs.Any())
                        {
                            <aside class="job-panel">
                                <div class="job-panel-header">
                                    <h3>Việc liên quan</h3>
                                </div>
                                <div class="job-panel-body">
                                    <div class="job-related-list">
                                        @foreach (var item in Model.RelatedJobs)
                                        {
                                            var relatedCompany = string.IsNullOrWhiteSpace(item.TenCongTy) ? "Doanh nghiệp" : item.TenCongTy;
                                            var relatedInitial = relatedCompany.Substring(0, 1).ToUpper();
                                            <a class="job-related-card" href="@Url.Action("Details", "Job", new { id = item.TinTuyenDungId })">
                                                @if (!string.IsNullOrWhiteSpace(item.LogoCongTy))
                                                {
                                                    <img class="job-related-logo" src="@Url.Content(item.LogoCongTy)" alt="@relatedCompany" />
                                                }
                                                else
                                                {
                                                    <span class="job-related-logo-fallback">@relatedInitial</span>
                                                }
                                                <span>
                                                    <span class="job-related-title">@item.TieuDe</span>
                                                    <span class="job-related-meta">@item.TenDiaDiem · @item.LuongHienThi</span>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </aside>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@using System.Linq
@using WebsiteTuyenDung.Models.Constants
@model WebsiteTuyenDung.Models.ViewModels.UngVienChiTietDonViewModel
@{
    ViewBag.Title = "Chi tiết đơn ứng tuyển";
    ViewBag.PublicBodyClass = "candidate-area";

    var don = Model.DonUngTuyen;
    var tin = don.TinTuyenDung;
    var congTy = tin.HoSoCongTy;
    var tenCongTy = congTy != null && !string.IsNullOrWhiteSpace(congTy.TenCongTy)
        ? congTy.TenCongTy
        : "Doanh nghiệp";
    var logoUrl = congTy != null ? congTy.Logo : null;
    var initials = tenCongTy.Substring(0, 1).ToUpper();
    var trangThaiText = TrangThaiDonUngTuyen.ToDisplayText(don.TrangThaiDon);
    var statusClass = don.TrangThaiDon == TrangThaiDonUngTuyen.DuocChapNhan
        ? "is-success"
        : (don.TrangThaiDon == TrangThaiDonUngTuyen.BiTuChoi || don.TrangThaiDon == TrangThaiDonUngTuyen.DaRut ? "is-muted" : "is-active");
}

@section styles {
    <style>
        .application-detail-page {
            padding: 52px 0 78px;
        }

        .application-detail-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 340px;
            gap: 24px;
            align-items: start;
        }

        .application-card {
            border: 1px solid #e2e8ee;
            border-radius: 18px;
            background: #ffffff;
            overflow: hidden;
        }

        .application-card + .application-card {
            margin-top: 18px;
        }

        .application-head {
            display: flex;
            gap: 16px;
            padding: 24px;
            border-bottom: 1px solid #edf1f4;
        }

        .application-logo,
        .application-logo-fallback {
            width: 64px;
            height: 64px;
            flex: 0 0 64px;
            border: 1px solid #e5ebef;
            border-radius: 14px;
            background: #ffffff;
        }

        .application-logo {
            padding: 8px;
            object-fit: contain;
        }

        .application-logo-fallback {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #20252a;
            font-size: 1.35rem;
            font-weight: 750;
        }

        .application-title {
            margin: 0 0 8px;
            color: #111827;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -.035em;
            line-height: 1.35;
        }

        .application-company {
            margin: 0 0 12px;
            color: #66727d;
            font-size: 14px;
        }

        .application-status {
            display: inline-flex;
            align-items: center;
            height: 28px;
            padding: 0 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }

        .application-status.is-active {
            background: #eef2f5;
            color: #20252a;
        }

        .application-status.is-success {
            background: #ecf8f0;
            color: #187540;
        }

        .application-status.is-muted {
            background: #f1f3f5;
            color: #68727c;
        }

        .application-section {
            padding: 24px;
        }

        .application-section-title {
            margin: 0 0 16px;
            color: #111827;
            font-size: 1rem;
            font-weight: 650;
        }

        .application-info {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .application-info-item {
            padding: 14px;
            border: 1px solid #edf1f4;
            border-radius: 14px;
            background: #fbfcfd;
        }

        .application-info-label {
            display: block;
            margin-bottom: 5px;
            color: #7a8792;
            font-size: 12px;
        }

        .application-info-value {
            display: block;
            color: #17212b;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
        }

        .application-note {
            margin: 0;
            padding: 16px;
            border: 1px solid #edf1f4;
            border-radius: 14px;
            background: #fbfcfd;
            color: #4d5964;
            font-size: 14px;
            line-height: 1.75;
            white-space: pre-line;
        }

        .application-timeline {
            display: grid;
            gap: 14px;
        }

        .application-timeline-item {
            position: relative;
            padding-left: 24px;
        }

        .application-timeline-item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 4px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #20252a;
        }

        .application-timeline-item::after {
            content: "";
            position: absolute;
            left: 4px;
            top: 18px;
            bottom: -16px;
            width: 1px;
            background: #e4e9ee;
        }

        .application-timeline-item:last-child::after {
            display: none;
        }

        .application-timeline-status {
            display: block;
            color: #17212b;
            font-size: 14px;
            font-weight: 650;
        }

        .application-timeline-meta {
            display: block;
            margin-top: 3px;
            color: #7a8792;
            font-size: 12px;
        }

        .application-timeline-note {
            margin-top: 8px;
            color: #56616c;
            font-size: 13px;
            line-height: 1.65;
            white-space: pre-line;
        }

        .application-side {
            display: grid;
            gap: 18px;
        }

        .application-side-card {
            border: 1px solid #e2e8ee;
            border-radius: 18px;
            padding: 22px;
            background: #ffffff;
        }

        .application-side-card.is-dark {
            border-color: #20252a;
            background: #20252a;
            color: #ffffff;
        }

        .application-side-card h2 {
            margin: 0 0 14px;
            color: inherit;
            font-size: 1rem;
            font-weight: 650;
        }

        .application-side-list {
            display: grid;
            gap: 12px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .application-side-list li {
            display: flex;
            gap: 10px;
            color: #66727d;
            font-size: 13px;
            line-height: 1.55;
        }

        .application-side-card.is-dark .application-side-list li {
            color: rgba(255, 255, 255, .76);
        }

        .application-side-list i {
            width: 16px;
            margin-top: 3px;
            color: #20252a;
        }

        .application-side-card.is-dark .application-side-list i {
            color: rgba(255, 255, 255, .72);
        }

        .application-actions {
            display: grid;
            gap: 10px;
        }

        .application-actions .btn {
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
        }

        .application-actions .btn-dark {
            background: #20252a;
            border-color: #20252a;
        }

        .application-actions .btn-outline-dark {
            color: #20252a;
            border-color: #cfd7df;
        }

        .application-actions .btn-outline-dark:hover,
        .application-actions .btn-outline-dark:focus {
            background: #20252a;
            border-color: #20252a;
            color: #ffffff;
        }

        @@media (max-width: 991.98px) {
            .application-detail-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .application-head {
                flex-direction: column;
            }

            .application-info {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<main class="clean-page application-detail-page">
    <div class="container">
        <div class="clean-heading">
            <div>
                <span class="clean-label">Ứng viên</span>
                <h1>Chi tiết đơn ứng tuyển</h1>
                <p>Theo dõi trạng thái xử lý, CV đã nộp và phản hồi từ nhà tuyển dụng.</p>
            </div>
            <a class="btn btn-outline-dark" href="@Url.Action("DonUngTuyen", "UngVien")">Quay lại danh sách</a>
        </div>

        <div class="application-detail-grid">
            <div>
                <article class="application-card">
                    <div class="application-head">
                        @if (!string.IsNullOrWhiteSpace(logoUrl))
                        {
                            <img class="application-logo" src="@Url.Content(logoUrl)" alt="@tenCongTy" />
                        }
                        else
                        {
                            <div class="application-logo-fallback">@initials</div>
                        }
                        <div>
                            <h2 class="application-title">@tin.TieuDe</h2>
                            <p class="application-company">@tenCongTy</p>
                            <span class="application-status @statusClass">@trangThaiText</span>
                        </div>
                    </div>

                    <div class="application-section">
                        <h3 class="application-section-title">Thông tin đơn</h3>
                        <div class="application-info">
                            <div class="application-info-item">
                                <span class="application-info-label">Ngày nộp</span>
                                <span class="application-info-value">@don.NgayNop.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="application-info-item">
                                <span class="application-info-label">CV đã chọn</span>
                                <span class="application-info-value">
                                    @if (don.CVUngVien != null)
                                    {
                                        <a href="@Url.Action("XemCVFile", "UngVien", new { id = don.CVUngVienId })" target="_blank">@don.CVUngVien.TenCV</a>
                                    }
                                    else
                                    {
                                        <span>Chưa cập nhật</span>
                                    }
                                </span>
                            </div>
                            <div class="application-info-item">
                                <span class="application-info-label">Ngành nghề</span>
                                <span class="application-info-value">@(tin.NganhNghe != null ? tin.NganhNghe.TenNganhNghe : "Chưa cập nhật")</span>
                            </div>
                            <div class="application-info-item">
                                <span class="application-info-label">Địa điểm</span>
                                <span class="application-info-value">@(tin.DiaDiem != null ? tin.DiaDiem.TenDiaDiem : "Chưa cập nhật")</span>
                            </div>
                        </div>
                    </div>

                    <div class="application-section">
                        <h3 class="application-section-title">Thư giới thiệu</h3>
                        <p class="application-note">@(string.IsNullOrWhiteSpace(don.ThuGioiThieu) ? "Bạn không nhập thư giới thiệu khi nộp đơn." : don.ThuGioiThieu)</p>
                    </div>

                    <div class="application-section">
                        <h3 class="application-section-title">Ghi chú xử lý</h3>
                        <p class="application-note">@(string.IsNullOrWhiteSpace(don.GhiChuXuLy) ? "Nhà tuyển dụng chưa cập nhật ghi chú xử lý." : don.GhiChuXuLy)</p>
                    </div>
                </article>

                <section class="application-card">
                    <div class="application-section">
                        <h3 class="application-section-title">Lịch sử trạng thái</h3>
                        @if (Model.LichSuTrangThaiDons != null && Model.LichSuTrangThaiDons.Any())
                        {
                            <div class="application-timeline">
                                @foreach (var item in Model.LichSuTrangThaiDons)
                                {
                                    <div class="application-timeline-item">
                                        <span class="application-timeline-status">@TrangThaiDonUngTuyen.ToDisplayText(item.TrangThaiMoi)</span>
                                        <span class="application-timeline-meta">@item.ThoiGianThayDoi.ToString("dd/MM/yyyy HH:mm") - @(item.ApplicationUser != null ? item.ApplicationUser.Email : "Hệ thống")</span>
                                        @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                        {
                                            <div class="application-timeline-note">@item.GhiChu</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="application-note">Chưa có lịch sử trạng thái cho đơn ứng tuyển này.</p>
                        }
                    </div>
                </section>
            </div>

            <aside class="application-side">
                <div class="application-side-card is-dark">
                    <h2>Tóm tắt việc làm</h2>
                    <ul class="application-side-list">
                        <li><i class="bi bi-geo-alt"></i><span>@(tin.DiaDiem != null ? tin.DiaDiem.TenDiaDiem : "Chưa cập nhật")</span></li>
                        <li><i class="bi bi-briefcase"></i><span>@(tin.LoaiHinhLamViec != null ? tin.LoaiHinhLamViec.TenLoaiHinhLamViec : "Chưa cập nhật")</span></li>
                        <li><i class="bi bi-layers"></i><span>@(tin.CapDoKinhNghiem != null ? tin.CapDoKinhNghiem.TenCapDoKinhNghiem : "Chưa cập nhật")</span></li>
                        <li><i class="bi bi-calendar2-check"></i><span>Hạn nộp: @tin.HanNopHoSo.ToString("dd/MM/yyyy")</span></li>
                    </ul>
                </div>

                <div class="application-side-card">
                    <h2>Thao tác</h2>
                    <div class="application-actions">
                        <a href="@Url.Action("Details", "Job", new { id = don.TinTuyenDungId })" class="btn btn-dark">Xem tin tuyển dụng</a>
                        <a href="@Url.Action("DonUngTuyen", "UngVien")" class="btn btn-outline-dark">Quay lại danh sách</a>
                        @if (Model.CoTheRutDon)
                        {
                            using (Html.BeginForm("RutDon", "UngVien", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@don.DonUngTuyenId" />
                                <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Bạn có chắc muốn rút đơn ứng tuyển này không?');">Rút đơn ứng tuyển</button>
                            }
                        }
                    </div>
                </div>
            </aside>
        </div>
    </div>
</main>

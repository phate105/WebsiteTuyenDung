@using System.Linq
@using WebsiteTuyenDung.Models.Constants
@model WebsiteTuyenDung.Models.Entities.TinTuyenDung

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.PageTitle = "Chi tiết kiểm duyệt tin";
    ViewBag.Title = "Chi tiết kiểm duyệt tin";
    ViewBag.PageDescription = "Xem kỹ nội dung tin trước khi duyệt hoặc từ chối.";
    var ngayGuiDuyet = Model.NhatKyDuyetTins != null
        ? Model.NhatKyDuyetTins.Where(x => x.HanhDong == HanhDongDuyetTin.GuiDuyet).OrderByDescending(x => x.ThoiGianXuLy).Select(x => (System.DateTime?)x.ThoiGianXuLy).FirstOrDefault()
        : null;
}

<div class="row">
    <div class="col-md-8">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">@Model.TieuDe</h3>
            </div>
            <div class="box-body">
                <dl class="dl-horizontal">
                    <dt>Công ty</dt>
                    <dd>@(Model.HoSoCongTy != null ? Model.HoSoCongTy.TenCongTy : "Chưa cập nhật")</dd>
                    <dt>Ngành nghề</dt>
                    <dd>@(Model.NganhNghe != null ? Model.NganhNghe.TenNganhNghe : "Chưa cập nhật")</dd>
                    <dt>Địa điểm</dt>
                    <dd>@(Model.DiaDiem != null ? Model.DiaDiem.TenDiaDiem : "Chưa cập nhật")</dd>
                    <dt>Loại hình làm việc</dt>
                    <dd>@(Model.LoaiHinhLamViec != null ? Model.LoaiHinhLamViec.TenLoaiHinhLamViec : "Chưa cập nhật")</dd>
                    <dt>Cấp độ kinh nghiệm</dt>
                    <dd>@(Model.CapDoKinhNghiem != null ? Model.CapDoKinhNghiem.TenCapDoKinhNghiem : "Chưa cập nhật")</dd>
                    <dt>Mô tả công việc</dt>
                    <dd style="white-space: pre-line;">@Model.MoTaCongViec</dd>
                    <dt>Yêu cầu</dt>
                    <dd style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.YeuCau) ? "Chưa cập nhật" : Model.YeuCau)</dd>
                    <dt>Quyền lợi</dt>
                    <dd style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.QuyenLoi) ? "Chưa cập nhật" : Model.QuyenLoi)</dd>
                    <dt>Lương</dt>
                    <dd>
                        @if (Model.LuongToiThieu.HasValue || Model.LuongToiDa.HasValue)
                        {
                            var luongToiThieu = Model.LuongToiThieu.HasValue ? string.Format("{0:#,##0}", Model.LuongToiThieu.Value) : "Thỏa thuận";
                            var luongToiDa = Model.LuongToiDa.HasValue ? string.Format("{0:#,##0}", Model.LuongToiDa.Value) : "Thỏa thuận";
                            @(string.Format("{0} - {1} VNĐ", luongToiThieu, luongToiDa))
                        }
                        else
                        {
                            <span>Thỏa thuận</span>
                        }
                    </dd>
                    <dt>Hạn nộp hồ sơ</dt>
                    <dd>@Model.HanNopHoSo.ToString("dd/MM/yyyy")</dd>
                    <dt>Ngày tạo</dt>
                    <dd>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt>Ngày gửi duyệt</dt>
                    <dd>@(ngayGuiDuyet.HasValue ? ngayGuiDuyet.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa gửi duyệt")</dd>
                    <dt>Ngày đăng</dt>
                    <dd>@(Model.NgayDang.HasValue ? Model.NgayDang.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng")</dd>
                    <dt>Ngày cập nhật</dt>
                    <dd>@Model.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt>Trạng thái</dt>
                    <dd><span class="label @TrangThaiTinTuyenDung.ToLabelCss(Model.TrangThaiTin)">@TrangThaiTinTuyenDung.ToDisplayText(Model.TrangThaiTin)</span></dd>
                </dl>
            </div>
            <div class="box-footer">
                <a href="@Url.Action("Index", "KiemDuyetTinTuyenDung")" class="btn btn-default">Quay lại</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="box box-warning">
            <div class="box-header with-border">
                <h3 class="box-title">Thao tác kiểm duyệt</h3>
            </div>
            <div class="box-body">
                @if (Model.TrangThaiTin == TrangThaiTinTuyenDung.ChoDuyet)
                {
                    using (Html.BeginForm("Duyet", "KiemDuyetTinTuyenDung", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.TinTuyenDungId" />
                        <button type="submit" class="btn btn-success btn-block">Duyệt tin</button>
                    }

                    <hr />

                    using (Html.BeginForm("TuChoi", "KiemDuyetTinTuyenDung", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.TinTuyenDungId" />
                        <div class="form-group">
                            <label>Lý do từ chối</label>
                            <textarea name="lyDoTuChoi" class="form-control" rows="4" placeholder="Nhập lý do từ chối để employer sửa lại tin"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger btn-block">Từ chối tin</button>
                    }
                }
                else if (Model.TrangThaiTin == TrangThaiTinTuyenDung.DaDuyet)
                {
                    using (Html.BeginForm("DongTin", "KiemDuyetTinTuyenDung", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.TinTuyenDungId" />
                        <button type="submit" class="btn btn-primary btn-block">Đóng tin</button>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Tin này hiện không có thao tác xử lý thêm.</p>
                }
            </div>
        </div>

        <div class="box box-default">
            <div class="box-header with-border">
                <h3 class="box-title">Nhật ký xử lý</h3>
            </div>
            <div class="box-body">
                @if (Model.NhatKyDuyetTins != null && Model.NhatKyDuyetTins.Any())
                {
                    <ul class="list-unstyled">
                        @foreach (var log in Model.NhatKyDuyetTins.OrderByDescending(x => x.ThoiGianXuLy))
                        {
                            <li style="margin-bottom: 12px;">
                                <strong>@HanhDongDuyetTin.ToDisplayText(log.HanhDong)</strong><br />
                                <small>@log.ThoiGianXuLy.ToString("dd/MM/yyyy HH:mm") - @(log.ApplicationUser != null ? log.ApplicationUser.Email : "Hệ thống")</small>
                                @if (!string.IsNullOrWhiteSpace(log.LyDoTuChoi))
                                {
                                    <div style="white-space: pre-line; margin-top: 4px;">@log.LyDoTuChoi</div>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Chưa có nhật ký xử lý.</p>
                }
            </div>
        </div>
    </div>
</div>

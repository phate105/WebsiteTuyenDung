@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Đã có lỗi xảy ra - VietJob</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f6f8;
            color: #1f2933;
            font-family: Arial, Helvetica, sans-serif;
        }

        .error-card {
            width: min(520px, calc(100% - 32px));
            padding: 34px;
            background: #fff;
            border: 1px solid #dfe4ea;
            border-radius: 16px;
        }

        .error-brand {
            display: inline-block;
            padding: 9px 16px;
            margin-bottom: 26px;
            background: #d9292f;
            color: #fff;
            font-weight: 700;
            font-style: italic;
        }

        h1 {
            margin: 0 0 10px;
            font-size: 28px;
        }

        p {
            margin: 0 0 24px;
            color: #65717c;
            line-height: 1.6;
        }

        a {
            display: inline-block;
            padding: 11px 18px;
            background: #252a30;
            color: #fff;
            border-radius: 8px;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <main class="error-card">
        <span class="error-brand">VietJob</span>
        <h1>Đã có lỗi xảy ra</h1>
        <p>Hệ thống chưa xử lý được yêu cầu này. Bạn có thể quay lại trang chủ và thử lại sau.</p>
        <a href="@Url.Action("Index", "Home")">Về trang chủ</a>
    </main>
</body>
</html>

@using System.Collections.Generic
@using System.Linq
@using WebsiteTuyenDung.Models
@using WebsiteTuyenDung.Models.Constants
@{
    var pageTitle = string.IsNullOrWhiteSpace(ViewBag.Title as string) ? "VietJob" : (string)ViewBag.Title;
    var isAuthenticated = Request.IsAuthenticated;
    var isCandidate = isAuthenticated && User.IsInRole(ApplicationRoles.UngVien);
    var isEmployer = isAuthenticated && User.IsInRole(ApplicationRoles.NhaTuyenDung);
    var isAdmin = isAuthenticated && User.IsInRole(ApplicationRoles.Admin);
    var homeUrl = Url.Action("Index", "Home");
    var jobsUrl = Url.Action("Index", "Job");
    var employersUrl = homeUrl + "#nha-tuyen-dung-tieu-bieu";
    var categoriesUrl = homeUrl + "#nganh-nghe-noi-bat";
    var navIndustryNames = new[]
    {
        "Công nghệ Thông tin",
        "Kinh doanh/Bán hàng",
        "Marketing/Quảng cáo",
        "Hành chính/Văn phòng",
        "Kế toán/Kiểm toán",
        "Tài chính/Ngân hàng",
        "Xây dựng/Kiến trúc",
        "Nhân sự",
        "Sản xuất/Kỹ thuật",
        "Chăm sóc khách hàng"
    };
    var navLocationNames = new[]
    {
        "Hồ Chí Minh",
        "Hà Nội",
        "Đà Nẵng",
        "Cần Thơ",
        "Bình Dương",
        "Hải Phòng",
        "Đồng Nai",
        "Quảng Ninh"
    };
    var navWorkTypeNames = new[]
    {
        "Toàn thời gian",
        "Bán thời gian",
        "Remote",
        "Hybrid",
        "Thực tập",
        "Thời vụ"
    };
    Dictionary<string, int> navIndustryMap;
    Dictionary<string, int> navLocationMap;
    Dictionary<string, int> navWorkTypeMap;
    using (var navDb = ApplicationDbContext.Create())
    {
        navIndustryMap = navDb.NganhNghes
            .Where(x => x.TrangThai)
            .ToList()
            .ToDictionary(x => x.TenNganhNghe, x => x.NganhNgheId);
        navLocationMap = navDb.DiaDiems
            .Where(x => x.TrangThai)
            .ToList()
            .ToDictionary(x => x.TenDiaDiem, x => x.DiaDiemId);
        navWorkTypeMap = navDb.LoaiHinhLamViecs
            .Where(x => x.TrangThai)
            .ToList()
            .ToDictionary(x => x.TenLoaiHinhLamViec, x => x.LoaiHinhLamViecId);
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@pageTitle - VietJob</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/Jobentry/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/Content/Jobentry/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/Content/Jobentry/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Jobentry/css/style.css" rel="stylesheet" />
    <style>
        :root {
            --vj-nav: #2f3135;
            --vj-nav-soft: #373a40;
            --vj-primary: #0f8bb7;
            --vj-accent: #28c7f4;
            --vj-bg: #f4f7fa;
            --vj-text: #102331;
            --vj-muted: #617784;
        }

        body {
            background: var(--vj-bg);
            color: var(--vj-text);
        }

        .public-shell {
            width: 100%;
            max-width: none !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            background: var(--vj-bg) !important;
        }

        .public-navbar {
            width: 100%;
            padding: 0;
            background: var(--vj-nav) !important;
            border-bottom: 1px solid rgba(255, 255, 255, .08);
            box-shadow: none;
            top: 0 !important;
            z-index: 1100 !important;
            transition: none !important;
            animation: none !important;
        }

        .navbar-light.sticky-top.public-navbar {
            top: 0 !important;
            transition: none !important;
            animation: none !important;
        }

        .public-navbar-inner {
            width: 100%;
            max-width: 1320px;
            min-height: 55px;
            margin: 0 auto;
            padding: 0 calc(var(--bs-gutter-x, 1.5rem) * .5);
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
        }

        .public-brand {
            flex: 0 0 auto;
            min-width: 86px;
            height: 34px !important;
            margin-right: 14px;
            padding: 0 14px !important;
            justify-content: center;
            background: #e12f2f;
            border: 1px solid #e12f2f;
            border-radius: 2px;
            text-decoration: none;
        }

        .public-brand h1 {
            font-size: .98rem;
            line-height: 1;
            letter-spacing: -.045em;
            font-weight: 750;
            font-style: italic;
            transform: skewX(-2deg);
        }

        .brand-viet,
        .brand-job {
            color: #ffffff;
        }

        .public-brand:hover,
        .public-brand:focus {
            background: #ffffff;
            border-color: #ffffff;
        }

        .public-brand:hover .brand-viet,
        .public-brand:hover .brand-job,
        .public-brand:focus .brand-viet,
        .public-brand:focus .brand-job {
            color: #23272f;
        }

        .public-navbar.navbar-light .navbar-brand,
        .public-navbar.navbar-light a.btn {
            height: auto !important;
        }

        .public-navbar.navbar-light .navbar-brand.public-brand {
            height: 34px !important;
        }

        .brand-subtitle {
            display: none;
        }

        .public-nav-collapse {
            align-items: center;
            justify-content: space-between;
            flex: 1 1 auto;
            width: auto;
        }

        .public-nav-links {
            align-items: center;
            align-self: stretch;
            gap: 0;
            margin-left: 0 !important;
            margin-right: auto !important;
        }

        .public-navbar.navbar-light .navbar-nav.public-nav-links .nav-link {
            margin-right: 0 !important;
            min-height: 55px;
            display: inline-flex;
            align-items: center;
            padding: 0 14px !important;
            border-radius: 0;
            color: #ffffff !important;
            font-size: 11px;
            font-weight: 400;
            letter-spacing: .035em;
            text-transform: uppercase;
            white-space: nowrap;
            transition: none !important;
        }

        .public-navbar.navbar-light .navbar-nav.public-nav-links .nav-link:hover,
        .public-mega-item:hover > .public-mega-trigger,
        .public-mega-item:focus-within > .public-mega-trigger,
        .public-mega-item.is-open > .public-mega-trigger {
            background: #5d6368;
            color: #ffffff !important;
        }

        .public-mega-item {
            position: relative;
        }

        .public-mega-trigger {
            cursor: pointer;
            gap: 6px;
        }

        .public-mega-caret {
            display: inline-flex;
            align-items: center;
            color: #ffffff;
            font-size: .8rem;
            transition: transform .14s ease;
        }

        .public-mega-item:hover .public-mega-caret,
        .public-mega-item:focus-within .public-mega-caret,
        .public-mega-item.is-open .public-mega-caret {
            transform: rotate(180deg);
            color: #ffffff;
        }

        .public-mega-menu {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1055;
            width: min(720px, calc(100vw - 44px));
            padding: 0;
            border: 0;
            border-radius: 0;
            background: #74797c;
            box-shadow: none;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(4px);
            transition: none !important;
        }

        .public-about-menu {
            width: 172px;
            background: #74797c;
        }

        .public-mega-menu::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: -8px;
            height: 8px;
        }

        .public-mega-item:hover .public-mega-menu,
        .public-mega-item:focus-within .public-mega-menu,
        .public-mega-item.is-open .public-mega-menu {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

        .public-mega-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0;
        }

        .public-mega-grid > div {
            padding: 12px 16px 14px;
            border-right: 1px solid rgba(255, 255, 255, .12);
        }

        .public-mega-grid > div:last-child {
            border-right: 0;
        }

        .public-mega-heading {
            margin: 0 0 8px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .02em;
        }

        .public-mega-list {
            display: grid;
            gap: 0;
        }

        .public-about-list {
            padding: 6px 0;
        }

        .public-mega-link {
            display: block;
            margin: 0 -10px;
            padding: 7px 10px;
            color: #ffffff;
            font-size: 12.5px;
            font-weight: 400;
            line-height: 1.35;
            text-decoration: none;
        }

        .public-mega-link:hover,
        .public-mega-link:focus {
            color: #ffffff;
            background: #555b5f;
            text-decoration: none;
        }

        .public-about-list .public-mega-link {
            margin: 0;
            padding: 10px 16px;
            font-size: 12.5px;
        }

        .public-navbar .navbar-toggler {
            border-color: rgba(255, 255, 255, .18);
        }

        .public-navbar .navbar-toggler-icon {
            filter: invert(1);
        }

        .public-nav-actions {
            flex: 0 0 auto;
            align-items: center;
            gap: 8px;
        }

        .public-nav-actions .dropdown {
            position: relative;
        }

        .public-nav-actions .dropdown::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 100%;
            height: 10px;
        }

        .nav-account-dropdown::after {
            left: 0;
            right: auto;
            width: 182px;
            height: 14px;
        }

        .public-navbar .public-nav-actions .btn,
        .public-navbar .public-nav-actions .dropdown-toggle {
            width: auto;
            min-width: 74px;
            height: 32px !important;
            min-height: 32px;
            padding: 0 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            font-size: 11px;
            font-weight: 500;
            line-height: 1;
            border-radius: 7px;
            transition: none !important;
        }

        .public-navbar .public-nav-actions .btn:focus,
        .public-navbar .public-nav-actions .btn:active,
        .public-navbar .public-nav-actions .btn:focus-visible,
        .public-navbar .public-nav-actions .dropdown-toggle:focus,
        .public-navbar .public-nav-actions .dropdown-toggle:active,
        .public-navbar .public-nav-actions .dropdown-toggle:focus-visible {
            outline: 0 !important;
            box-shadow: none !important;
        }

        .nav-auth-group .btn {
            padding-left: 12px;
            padding-right: 12px;
        }

        .btn-nav-login {
            border: 1px solid rgba(255, 255, 255, .10);
            background: transparent;
            color: #ffffff;
        }

        .btn-nav-login:hover,
        .btn-nav-login:focus,
        .btn-nav-login:active {
            background: rgba(255, 255, 255, .08);
            border-color: rgba(255, 255, 255, .18);
            color: #ffffff;
        }

        .btn-nav-employer {
            border: 1px solid rgba(255, 255, 255, .12);
            background: rgba(255, 255, 255, .06);
            color: #ffffff;
        }

        .btn-nav-employer:hover,
        .btn-nav-employer:focus,
        .btn-nav-employer:active {
            background: rgba(255, 255, 255, .14);
            border-color: rgba(255, 255, 255, .30);

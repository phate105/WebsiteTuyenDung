@using WebsiteTuyenDung.Models.Constants
@{
    var isAdmin = User.IsInRole(ApplicationRoles.Admin);
    var homeAction = isAdmin ? "AdminDashboard" : "EmployerDashboard";
    var roleLabel = isAdmin ? "Quản trị viên" : "Nhà tuyển dụng";
}

@using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "adminPortalLogoutForm" }))
{
    @Html.AntiForgeryToken()
}

<header class="main-header">
    <a href="@Url.Action("Index", "Home")" class="logo admin-vietjob-logo">
        <span class="logo-mini"><b>VJ</b></span>
        <span class="logo-lg"><b>VietJob</b></span>
    </a>

    <nav class="navbar navbar-static-top" role="navigation">
        <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
            <span class="sr-only">Toggle navigation</span>
        </a>

        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
                <li class="dropdown notifications-menu admin-notification-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-label="Thông báo">
                        <i class="fa fa-bell-o"></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="header">Thông báo</li>
                        <li>
                            <ul class="menu">
                                <li>
                                    <a href="javascript:void(0)">
                                        <span class="admin-notification-text">Chưa có thông báo mới.</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="footer">
                            <a href="@Url.Action(homeAction, "Home")">Xem tổng quan</a>
                        </li>
                    </ul>
                </li>
                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <img src="@Url.Content("~/Content/AdminLTE/dist/img/user2-160x160.jpg")" class="user-image" alt="User Image" />
                        <span class="hidden-xs">@(string.IsNullOrWhiteSpace(User.Identity.Name) ? roleLabel : User.Identity.Name)</span>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="user-header">
                            <img src="@Url.Content("~/Content/AdminLTE/dist/img/user2-160x160.jpg")" class="img-circle" alt="User Image" />
                            <p>
                                @(string.IsNullOrWhiteSpace(User.Identity.Name) ? roleLabel : User.Identity.Name)
                                <small>Website tuyển dụng và tìm kiếm việc làm</small>
                            </p>
                        </li>
                        <li class="user-footer">
                            <div class="pull-left">
                                <a href="@Url.Action(homeAction, "Home")" class="btn btn-default btn-flat">Tổng quan</a>
                            </div>
                            <div class="pull-right">
                                <a href="javascript:void(0)" onclick="document.getElementById('adminPortalLogoutForm').submit(); return false;" class="btn btn-default btn-flat">Đăng xuất</a>
                            </div>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>

@using WebsiteTuyenDung.Models.Constants
@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? string.Empty).ToString();
    var currentAction = (ViewContext.RouteData.Values["action"] ?? string.Empty).ToString();
    var isAdmin = User.IsInRole(ApplicationRoles.Admin);
    var isEmployer = User.IsInRole(ApplicationRoles.NhaTuyenDung);
    var isDanhMucMenu = string.Equals(currentController, "NganhNghe", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "DiaDiem", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "LoaiHinhLamViec", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "CapDoKinhNghiem", System.StringComparison.OrdinalIgnoreCase);
}

<aside class="main-sidebar">
    <section class="sidebar">
        <div class="user-panel">
            <div class="pull-left image">
                <img src="@Url.Content("~/Content/AdminLTE/dist/img/user2-160x160.jpg")" class="img-circle" alt="User Image" />
            </div>
            <div class="pull-left info">
                <p>@(isAdmin ? "Quản trị viên" : "Nhà tuyển dụng")</p>
                <a href="#"><i class="fa fa-circle text-success"></i> Đang hoạt động</a>
            </div>
        </div>

        <ul class="sidebar-menu">
            <li class="header">ĐIỀU HƯỚNG</li>

            @if (isAdmin)
            {
                <li class="@(string.Equals(currentController, "Home", System.StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "AdminDashboard", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("AdminDashboard", "Home")">
                        <i class="fa fa-dashboard"></i> <span>Dashboard</span>
                    </a>
                </li>
                <li class="@(string.Equals(currentController, "KiemDuyetTinTuyenDung", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("Index", "KiemDuyetTinTuyenDung")">
                        <i class="fa fa-check-square-o"></i> <span>Kiểm duyệt tin tuyển dụng</span>
                    </a>
                </li>
                <li class="treeview @(isDanhMucMenu ? "active menu-open" : string.Empty)">
                    <a href="#">
                        <i class="fa fa-list"></i> <span>Danh mục</span>
                        <i class="fa fa-angle-left pull-right"></i>
                    </a>
                    <ul class="treeview-menu">
                        <li class="@(string.Equals(currentController, "NganhNghe", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                            <a href="@Url.Action("Index", "NganhNghe")"><i class="fa fa-circle-o"></i> Ngành nghề</a>
                        </li>
                        <li class="@(string.Equals(currentController, "DiaDiem", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                            <a href="@Url.Action("Index", "DiaDiem")"><i class="fa fa-circle-o"></i> Địa điểm</a>
                        </li>
                        <li class="@(string.Equals(currentController, "LoaiHinhLamViec", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                            <a href="@Url.Action("Index", "LoaiHinhLamViec")"><i class="fa fa-circle-o"></i> Loại hình làm việc</a>
                        </li>
                        <li class="@(string.Equals(currentController, "CapDoKinhNghiem", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                            <a href="@Url.Action("Index", "CapDoKinhNghiem")"><i class="fa fa-circle-o"></i> Cấp độ kinh nghiệm</a>
                        </li>
                    </ul>
                </li>
                <li class="@(string.Equals(currentController, "TaiKhoan", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("Index", "TaiKhoan")">
                        <i class="fa fa-users"></i> <span>Quản lý tài khoản</span>
                    </a>
                </li>
                <li class="@(string.Equals(currentController, "ThongKe", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("Index", "ThongKe")">
                        <i class="fa fa-bar-chart"></i> <span>Thống kê</span>
                    </a>
                </li>
            }

            @if (isEmployer)
            {
                <li class="@(string.Equals(currentController, "Home", System.StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "EmployerDashboard", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("EmployerDashboard", "Home")">
                        <i class="fa fa-dashboard"></i> <span>Tổng quan</span>
                    </a>
                </li>
                <li class="@(string.Equals(currentController, "HoSoCongTy", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("Index", "HoSoCongTy")">
                        <i class="fa fa-building"></i> <span>Hồ sơ công ty</span>
                    </a>
                </li>
                <li class="treeview @(string.Equals(currentController, "TinTuyenDung", System.StringComparison.OrdinalIgnoreCase) ? "active menu-open" : string.Empty)">
                    <a href="#">
                        <i class="fa fa-briefcase"></i> <span>Tin tuyển dụng</span>
                        <i class="fa fa-angle-left pull-right"></i>
                    </a>
                    <ul class="treeview-menu">
                        <li class="@(string.Equals(currentController, "TinTuyenDung", System.StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Create", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                            <a href="@Url.Action("Create", "TinTuyenDung")"><i class="fa fa-circle-o"></i> Tạo tin tuyển dụng</a>
                        </li>
                        <li class="@(string.Equals(currentController, "TinTuyenDung", System.StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                            <a href="@Url.Action("Index", "TinTuyenDung")"><i class="fa fa-circle-o"></i> Danh sách tin của tôi</a>
                        </li>
                    </ul>
                </li>
                <li class="@(string.Equals(currentController, "HoSoUngTuyen", System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
                    <a href="@Url.Action("Index", "HoSoUngTuyen")">
                        <i class="fa fa-file-text-o"></i> <span>Hồ sơ ứng tuyển</span>
                    </a>
                </li>
            }

            <li>
                <a href="javascript:void(0)" onclick="document.getElementById('adminPortalLogoutForm').submit(); return false;">
                    <i class="fa fa-sign-out"></i> <span>Đăng xuất</span>
                </a>
            </li>
        </ul>
    </section>
</aside>

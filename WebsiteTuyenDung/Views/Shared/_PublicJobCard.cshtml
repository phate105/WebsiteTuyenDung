@model WebsiteTuyenDung.Models.ViewModels.PublicJobCardViewModel

<div class="job-item p-4 mb-4">
    <div class="row g-4">
        <div class="col-sm-12 col-md-8 d-flex align-items-center">
            @if (!string.IsNullOrWhiteSpace(Model.LogoCongTy))
            {
                <img class="flex-shrink-0 img-fluid border rounded job-logo" src="@Url.Content(Model.LogoCongTy)" alt="@Model.TenCongTy" />
            }
            else
            {
                <div class="flex-shrink-0 job-logo-fallback">@Model.TenCongTy.Substring(0, 1).ToUpper()</div>
            }
            <div class="text-start ps-4">
                <h5 class="mb-3">@Model.TieuDe</h5>
                <div class="mb-2 text-muted">@Model.TenCongTy</div>
                <span class="text-truncate me-3"><i class="fa fa-map-marker-alt text-primary me-2"></i>@Model.TenDiaDiem</span>
                <span class="text-truncate me-3"><i class="far fa-clock text-primary me-2"></i>@Model.TenLoaiHinhLamViec</span>
                <span class="text-truncate me-0"><i class="far fa-money-bill-alt text-primary me-2"></i>@Model.LuongHienThi</span>
            </div>
        </div>
        <div class="col-sm-12 col-md-4 d-flex flex-column align-items-start align-items-md-end justify-content-center">
            <div class="d-flex mb-3 gap-2">
                <a class="btn btn-outline-primary" href="@Url.Action("Details", "Job", new { id = Model.TinTuyenDungId })">Chi tiết</a>
                @if (Model.CoTheUngTuyen)
                {
                    <a class="btn btn-primary" href="@Url.Action("Details", "Job", new { id = Model.TinTuyenDungId })#apply-box">Ứng tuyển</a>
                }
            </div>
            <small class="text-truncate"><i class="far fa-calendar-alt text-primary me-2"></i>Hạn nộp: @Model.HanNopHoSo.ToString("dd/MM/yyyy")</small>
        </div>
    </div>
</div>

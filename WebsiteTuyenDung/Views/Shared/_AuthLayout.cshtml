@{
    var pageTitle = string.IsNullOrWhiteSpace(ViewBag.Title as string) ? "Tài khoản" : (string)ViewBag.Title;
    var bodyClass = string.IsNullOrWhiteSpace(ViewBag.AuthBodyClass as string)
        ? "hold-transition login-page"
        : (string)ViewBag.AuthBodyClass;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>@pageTitle - VietJob</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/AdminLTE/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/AdminLTE/dist/css/AdminLTE.min.css" />
    <style>
        body.login-page,
        body.register-page,
        body.login-page input,
        body.login-page button,
        body.login-page textarea,
        body.login-page select,
        body.register-page input,
        body.register-page button,
        body.register-page textarea,
        body.register-page select,
        body.login-page .login-box,
        body.register-page .register-box,
        body.login-page .login-logo,
        body.register-page .register-logo {
            font-family: 'Lexend', sans-serif;
        }

        body.login-page,
        body.register-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 42px 16px;
            background:
                radial-gradient(circle at 18% 18%, rgba(225, 47, 47, .08), transparent 28%),
                linear-gradient(135deg, #f7f7f8 0%, #eceff2 100%);
        }

        .login-box,
        .register-box {
            width: 390px;
            margin: 0;
        }

        .register-box {
            width: 420px;
        }

        .login-logo,
        .register-logo {
            margin-bottom: 22px;
            text-align: center;
        }

        .auth-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 112px;
            height: 42px;
            padding: 0 20px;
            border-radius: 3px;
            background: #e12f2f;
            color: #ffffff !important;
            font-size: 20px;
            font-style: italic;
            font-weight: 800;
            letter-spacing: -0.08em;
            line-height: 1;
            text-decoration: none !important;
            box-shadow: none;
            transform: skew(-3deg);
        }

        .auth-brand-mark span {
            display: inline-block;
            transform: skew(3deg);
        }

        .auth-box-body {
            padding: 24px 22px 22px;
            border: 1px solid #e1e5ea;
            border-top: 0;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(17, 24, 39, .08);
        }

        .login-box-msg {
            padding: 0 0 18px;
            color: #2f3740;
            font-size: 14px;
            font-weight: 500;
        }

        .login-box-body .form-control,
        .register-box-body .form-control {
            height: 42px;
            padding-right: 42px;
            border: 1px solid #d7dee5;
            border-radius: 6px;
            color: #1f252b;
            font-size: 13px;
            box-shadow: none;
        }

        .login-box-body .form-control:focus,
        .register-box-body .form-control:focus {
            border-color: #aeb8c2;
            box-shadow: none;
        }

        .login-box-body .form-control-feedback,
        .register-box-body .form-control-feedback {
            right: 0;
            width: 42px;
            height: 42px;
            line-height: 42px;
            color: #8a929a;
            text-align: center;
            pointer-events: none;
        }

        .auth-submit .btn-success,
        .auth-submit .btn-success:visited {
            height: 40px;
            border-radius: 6px !important;
            background-color: #25292e;
            border-color: #25292e;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
        }

        .auth-submit .btn-success:hover,
        .auth-submit .btn-success:focus,
        .auth-submit .btn-success:active,
        .auth-submit .btn-success.active,
        .auth-submit .btn-success:active:hover,
        .auth-submit .btn-success:active:focus {
            background-color: #1f2328;
            border-color: #1f2328;
            color: #ffffff;
            box-shadow: none !important;
            outline: 0;
        }

        .validation-summary-errors,
        .auth-alert {
            margin-bottom: 15px;
        }

        .field-validation-error {
            display: block;
            margin-top: 4px;
            font-size: 12px;
        }

        .auth-helper {
            margin-top: 15px;
            text-align: center;
            color: #626b75;
            font-size: 13px;
        }

        .auth-helper a {
            color: #d72626;
            font-weight: 600;
            text-decoration: none;
        }

        .auth-helper a:hover,
        .auth-helper a:focus {
            color: #b91f1f;
            text-decoration: underline;
        }

        .auth-divider {
            margin: 18px -22px 14px;
            border-color: #edf0f2;
        }

        .remember-row label {
            cursor: pointer;
            font-weight: 400;
            user-select: none;
            color: #4b5560;
            font-size: 13px;
        }

        .remember-row input[type="checkbox"] {
            margin-right: 6px;
        }

        .demo-account-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .demo-login-btn {
            width: 100%;
            text-align: left;
            white-space: normal;
            border-radius: 7px;
            padding: 10px 12px;
            border-color: #e1e5ea;
            background: #fafafa;
        }

        .demo-login-btn strong {
            display: block;
            color: #333;
            font-size: 13px;
        }

        .demo-login-btn span {
            display: block;
            margin-top: 4px;
            color: #777;
            font-size: 12px;
        }

        .demo-login-btn:hover,
        .demo-login-btn:focus {
            border-color: #d7a2a2;
            color: inherit;
            background: #fff7f7;
            box-shadow: none;
        }

        .auth-submit {
            margin-top: 6px;
        }

        .password-field {
            position: relative;
        }

        .password-field .form-control {
            padding-right: 42px;
        }

        .password-toggle {
            position: absolute;
            top: 0;
            right: 0;
            z-index: 3;
            width: 42px;
            height: 42px;
            border: 0;
            padding: 0;
            background: transparent;
            color: #777;
            line-height: 42px;
            text-align: center;
            outline: 0;
        }

        .password-toggle:hover,
        .password-toggle:focus {
            color: #d72626;
        }

        .register-role-field .form-control {
            padding-right: 42px;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: linear-gradient(45deg, transparent 50%, #8a929a 50%), linear-gradient(135deg, #8a929a 50%, transparent 50%);
            background-position: calc(100% - 20px) 18px, calc(100% - 14px) 18px;
            background-size: 6px 6px, 6px 6px;
            background-repeat: no-repeat;
        }

        @@media (max-width: 480px) {
            .login-box,
            .register-box {
                width: 90%;
                margin-top: 20px;
            }
        }
    </style>
</head>
<body class="@bodyClass">
    @RenderBody()

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Content/AdminLTE/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>

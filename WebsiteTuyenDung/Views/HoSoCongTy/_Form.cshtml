@model WebsiteTuyenDung.Models.ViewModels.HoSoCongTyFormViewModel
@{
    var submitText = ViewBag.SubmitText as string ?? "Lưu";
    var logoUrl = string.IsNullOrWhiteSpace(Model.CurrentLogo)
        ? null
        : (Model.CurrentLogo.StartsWith("http", System.StringComparison.OrdinalIgnoreCase) || Model.CurrentLogo.StartsWith("/")
            ? Model.CurrentLogo
            : Url.Content(Model.CurrentLogo));
}

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="box-body">
    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                <label>Tên công ty</label>
                @Html.TextBoxFor(m => m.TenCongTy, new { @class = "form-control", placeholder = "Nhập tên công ty" })
                @Html.ValidationMessageFor(m => m.TenCongTy, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Mã số thuế</label>
                @Html.TextBoxFor(m => m.MaSoThue, new { @class = "form-control", placeholder = "Nhập mã số thuế" })
            </div>

            <div class="form-group">
                <label>Email liên hệ</label>
                @Html.TextBoxFor(m => m.EmailLienHe, new { @class = "form-control", placeholder = "Nhập email liên hệ" })
                @Html.ValidationMessageFor(m => m.EmailLienHe, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Số điện thoại liên hệ</label>
                @Html.TextBoxFor(m => m.SoDienThoaiLienHe, new { @class = "form-control", placeholder = "Nhập số điện thoại liên hệ" })
            </div>

            <div class="form-group">
                <label>Địa chỉ</label>
                @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", placeholder = "Nhập địa chỉ công ty" })
            </div>

            <div class="form-group">
                <label>Website</label>
                @Html.TextBoxFor(m => m.Website, new { @class = "form-control", placeholder = "Ví dụ: example.com" })
            </div>

            <div class="form-group">
                <label>Mô tả công ty</label>
                @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 5, placeholder = "Giới thiệu ngắn về doanh nghiệp, văn hóa và định hướng tuyển dụng" })
            </div>
        </div>

        <div class="col-md-4">
            <div class="form-group">
                <label>Logo doanh nghiệp</label>
                <input type="file" name="logoFile" class="form-control" accept="image/*" />
                <p class="help-block">Hỗ trợ JPG, PNG, GIF, WEBP. Tối đa 5MB.</p>
                @Html.ValidationMessageFor(m => m.CurrentLogo, "", new { @class = "text-danger" })
            </div>

            @if (!string.IsNullOrWhiteSpace(logoUrl))
            {
                <div class="text-center" style="padding: 12px; border: 1px solid #eee; border-radius: 4px;">
                    <img src="@logoUrl" alt="Logo công ty" style="max-width: 100%; max-height: 220px; object-fit: contain;" />
                    <p class="help-block" style="margin-top: 10px;">Logo hiện tại</p>
                </div>
            }
            else
            {
                <div class="text-center text-muted" style="padding: 40px 10px; border: 1px dashed #ddd; border-radius: 4px;">
                    Chưa có logo công ty
                </div>
            }
        </div>
    </div>
</div>

<div class="box-footer">
    <button type="submit" class="btn btn-primary">@submitText</button>
    <a href="@Url.Action("Index", "HoSoCongTy")" class="btn btn-default">Quay lại</a>
</div>

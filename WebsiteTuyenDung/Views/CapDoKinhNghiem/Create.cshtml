@model WebsiteTuyenDung.Models.Entities.CapDoKinhNghiem

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Thêm cấp độ kinh nghiệm";
    ViewBag.PageTitle = "Thêm cấp độ kinh nghiệm";
}

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Thêm cấp độ kinh nghiệm</h3>
    </div>

    @using (Html.BeginForm("Create", "CapDoKinhNghiem", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="box-body">
            <div class="form-group">
                <label>Tên cấp độ kinh nghiệm</label>
                @Html.TextBoxFor(m => m.TenCapDoKinhNghiem, new { @class = "form-control", placeholder = "Nhập tên cấp độ kinh nghiệm" })
                @Html.ValidationMessageFor(m => m.TenCapDoKinhNghiem, "", new { @class = "text-danger" })
            </div>
            <div class="checkbox">
                <label>@Html.CheckBoxFor(m => m.TrangThai) Đang sử dụng</label>
            </div>
        </div>
        <div class="box-footer">
            <button type="submit" class="btn btn-primary">Lưu</button>
            <a href="@Url.Action("Index", "CapDoKinhNghiem")" class="btn btn-default">Quay lại</a>
        </div>
    }
</div>
